--------------------------------------------------------------------------------
-- Loop-Motor
--------------------------------------------------------------------------------

local loops = {}
local loopToggles = {}
local masterToggle

local function defineLoop(name, def)
	local loop = {
		name    = name,
		def     = def,
		running = false,
		token   = 0,
		ticks   = 0,
	}
	loop.stop = function()
		loop.running = false
		local toggle = loopToggles[name]
		if toggle then
			pcall(function()
				toggle:Set(false)
			end)
		end
	end
	loops[name] = loop
	return loop
end

local function startLoop(name)
	local loop = loops[name]
	if not loop or loop.running then
		return
	end

	loop.running = true
	loop.ticks   = 0
	loop.token  += 1
	local token  = loop.token

	Hub.log("loop '" .. name .. "' gestartet")
	Hub.toast({ title = name .. " laeuft", subtitle = "Loop gestartet", icon = "play", duration = 3 })
	Overlay.pulse(name .. " startet")
	if Hub.refreshLoops then
		Hub.refreshLoops()
	end
	nativeNotify("Big Hub", name .. " laeuft", 3)

	task.spawn(function()
		if loop.def.onStart then
			local ok, err = pcall(loop.def.onStart, loop)
			if not ok then
				warn("[BigHub] onStart " .. name .. ": " .. tostring(err))
				Hub.log("fehler in " .. name .. ".onStart: " .. tostring(err))
			end
		end

		while loop.running and loop.token == token and not window.unloaded do
			local ok, err = pcall(loop.def.step, loop)
			if not ok then
				warn("[BigHub] step " .. name .. ": " .. tostring(err))
				Hub.log("fehler in " .. name .. ".step: " .. tostring(err))
				Hub.toast({
					title = "Fehler in " .. name,
					subtitle = "Loop gestoppt, siehe Konsole",
					icon = "octagon-alert",
					duration = 5,
				})
				loop.stop()
				break
			end

			loop.ticks += 1

			local wait = 1
			if loop.def.interval then
				local okI, value = pcall(loop.def.interval)
				if okI and type(value) == "number" then
					wait = value
				end
			end
			task.wait(math.max(wait, 0.05))
		end

		loop.running = false
		Hub.log("loop '" .. name .. "' beendet nach " .. loop.ticks .. " Durchlaeufen")
		if Hub.refreshLoops then
			Hub.refreshLoops()
		end
		nativeNotify("Big Hub", name .. " gestoppt nach " .. loop.ticks .. " Durchlaeufen", 4)
		if loop.def.onStop then
			pcall(loop.def.onStop, loop)
		end
	end)
end

local function stopLoop(name)
	local loop = loops[name]
	if loop then
		loop.running = false
	end
end

local function stopAllLoops()
	for name in pairs(loops) do
		local loop = loops[name]
		if loop.running then
			loop.stop()
		end
	end
end

-- Von hier aus erreichen auch die Actions den Loop-Motor
Hub.startLoop = startLoop
Hub.loopRunning = function(name)
	local loop = loops[name]
	return loop ~= nil and loop.running == true
end

