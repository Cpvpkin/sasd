--== Orbs einsammeln ===========================================================
Actions.orbs = {
	interval = function()
		return FC.Orbs.Interval or 0.6
	end,

	onStart = function()
		local remote = Farm.remoteByName(FC.Orbs.Remote)
		if not remote then
			Hub.log("orbs: Remote '" .. tostring(FC.Orbs.Remote) .. "' fehlt")
			nativeNotify("Big Hub", "Orb-Remote nicht gefunden.", 7)
			return
		end
		Hub.log("orbs: sammle ueber " .. remote:GetFullName())
	end,

	step = function(loop)
		local remote = remoteFor(loop, FC.Orbs.Remote, "orbs")
		if not remote then
			return
		end

		local folder = Farm.orbFolder()
		if not folder then
			if loop.ticks % 20 == 0 then
				Hub.log("orbs: kein Orb-Ordner gefunden")
			end
			return
		end

		local root = Util.root()
		local here = root and root.Position
		local radius = tonumber(FC.Orbs.Radius) or 0

		local ids = {}
		for _, child in ipairs(folder:GetChildren()) do
			local id = tonumber(child.Name)
			if id then
				local take = true
				if radius > 0 and here then
					local position = positionOf(child)
					take = position ~= nil and (position - here).Magnitude <= radius
				end
				if take then
					table.insert(ids, id)
				end
			end
		end

		if #ids == 0 then
			return
		end

		-- in Haeppchen senden, damit kein Riesenpaket rausgeht
		local batch = math.max(tonumber(FC.Orbs.Batch) or 40, 1)
		local sent = 0
		for index = 1, #ids, batch do
			local chunk = {}
			for offset = index, math.min(index + batch - 1, #ids) do
				table.insert(chunk, ids[offset])
			end
			local ok = pcall(function()
				remote:FireServer(chunk)
			end)
			if ok then
				sent += #chunk
			end
			task.wait(0.05)
		end

		Hub.countAction()
		Overlay.set("target", sent .. " Orbs eingesammelt")
		Overlay.pulse("sammle Orbs")
		if loop.ticks % 10 == 0 then
			Hub.log("orbs: " .. sent .. " IDs geschickt (" .. #ids .. " im Radius)")
		end
	end,

	onStop = function()
		Hub.log("orbs: gestoppt")
	end,
}

--== Eggs: die Auto-Hatch des Spiels benutzen ==================================
Actions.eggs2 = {
	interval = function()
		return FC.Eggs.Interval or 2
	end,

	onStart = function()
		local mode = norm(FC.Eggs.Mode)
		Farm.eggModel = nil
		Farm.eggUidValue = trim(FC.Eggs.EggUid)

		Hub.log("eggs: Modus '" .. mode .. "', Egg '" .. tostring(FC.Eggs.EggName)
			.. "' x" .. tostring(FC.Eggs.Amount))

		-- 1. Egg in der Welt finden
		local egg, eggErr, score = Farm.findEgg(FC.Eggs.EggName)
		if egg then
			Farm.eggModel = egg
			Hub.log("eggs: Egg gefunden -> " .. egg:GetFullName()
				.. (score and score > 0 and "  (Name passt)" or "  (nur das naechste!)"))
		else
			Hub.log("eggs: " .. tostring(eggErr))
		end

		-- 2. hinfliegen und einmal E druecken
		if FC.Eggs.GoToEgg and egg then
			local position = positionOf(egg)
			if position then
				Overlay.set("target", "fliege zum Egg " .. egg.Name)
				Util.glide(position + Vector3.new(0, 4, 0), 140)
				local pressed, how = Farm.pressAt(egg, "Egg " .. egg.Name)
				Hub.log("eggs: am Egg E gedrueckt -> " .. tostring(how))
			end
		end

		-- 3. UID fuer das direkte Hatchen
		if Farm.eggUidValue == "" and egg then
			local uid, where = Farm.eggUid(egg)
			Farm.eggUidValue = uid or ""
			Hub.log("eggs: UID " .. tostring(uid) .. " (" .. tostring(where) .. ")")
		end
		if Farm.eggUidValue == "" and mode ~= "auto" then
			Hub.log("eggs: ohne UID geht 'direct' nicht - 'Debug: Egg-Infos' druecken")
		end

		-- 4. Webhook-Beobachter mitstarten
		Web.sendStart(FC.Eggs.EggName, FC.Eggs.Amount)
		if trim(WH.Url) ~= "" then
			if Hub.loopRunning and not Hub.loopRunning("hatchwatch") and Hub.startLoop then
				Hub.log("eggs: starte Pet-Beobachter fuer den Webhook")
				Hub.startLoop("hatchwatch")
			end
		else
			Hub.log("eggs: keine Webhook-URL, melde keine Pets")
		end
	end,

	step = function(loop)
		local mode = norm(FC.Eggs.Mode)
		local amount = tonumber(FC.Eggs.Amount) or 1
		local didSomething = false
		local verbose = loop.ticks < 3

		-- in Position bleiben, sonst zaehlt das Spiel das Egg nicht
		if FC.Eggs.GoToEgg and Farm.eggModel and Farm.eggModel.Parent then
			local position = positionOf(Farm.eggModel)
			local root = Util.root()
			if position and root then
				local away = (root.Position - (position + Vector3.new(0, 4, 0))).Magnitude
				if away > 15 then
					Util.glide(position + Vector3.new(0, 4, 0), 140)
					Farm.pressAt(Farm.eggModel, "Egg erneut")
				end
			end
		end

		-- Weg C: im offenen Egg-Menue den groessten Knopf druecken.
		-- Das ist der Weg, der dem Spielen per Hand am naechsten kommt.
		if FC.Eggs.ClickMenu then
			local ok, info, pick = Farm.clickBestHatch(loop.menuSkip or 0)
			if ok then
				didSomething = true
				loop.menuHits = (loop.menuHits or 0) + 1
				if verbose or loop.menuHits % 10 == 1 then
					Hub.log("eggs: Menue-Knopf " .. tostring(info) .. " geklickt"
						.. (pick and ("  [" .. pick.text:sub(1, 40) .. "]") or ""))
				end
				Overlay.set("target", "hatche " .. tostring(info))
			else
				-- klappt der groesste nicht, naechstkleineren versuchen
				if verbose then
					Hub.log("eggs: Menue -> " .. tostring(info))
				end
				loop.menuMiss = (loop.menuMiss or 0) + 1
				if loop.menuMiss % 4 == 0 then
					loop.menuSkip = ((loop.menuSkip or 0) + 1) % 4
					Hub.log("eggs: versuche den " .. (loop.menuSkip + 1)
						.. ". Knopf von oben")
				end
			end
		end

		-- Weg A: die Auto-Hatch des Spiels, alle paar Durchlaeufe erneuern
		if mode ~= "direct" then
			local every = math.max(tonumber(FC.Eggs.RefreshEvery) or 8, 1)
			if loop.ticks % every == 0 then
				local remote = Farm.remoteByName(FC.Eggs.EnableRemote)
				if remote then
					local ok, err = pcall(function()
						remote:FireServer(FC.Eggs.EggName, amount)
					end)
					didSomething = didSomething or ok
					if verbose or not ok then
						Hub.log("eggs: AutoHatch_Enable -> " .. (ok and "ok" or tostring(err)))
					end
				elseif verbose then
					Hub.log("eggs: Remote '" .. tostring(FC.Eggs.EnableRemote) .. "' nicht da")
				end
			else
				didSomething = true
			end
		end

		-- Weg B: direkt hatchen, ein Aufruf pro Durchlauf
		if mode ~= "auto" and Farm.eggUidValue ~= "" then
			local remote = Farm.remoteByName(FC.Eggs.HatchRemote)
			if remote then
				local ok, result = pcall(function()
					if remote:IsA("RemoteFunction") then
						return remote:InvokeServer(Farm.eggUidValue, amount)
					end
					return remote:FireServer(Farm.eggUidValue, amount)
				end)
				didSomething = didSomething or ok
				if verbose or not ok then
					Hub.log("eggs: " .. tostring(FC.Eggs.HatchRemote) .. " -> "
						.. (ok and ("ok, Antwort " .. tostring(result)) or tostring(result)))
				end
			elseif verbose then
				Hub.log("eggs: Remote '" .. tostring(FC.Eggs.HatchRemote) .. "' nicht da")
			end
		end

		-- Beobachter nachziehen, falls er ausgegangen ist
		if trim(WH.Url) ~= "" and Hub.loopRunning
			and not Hub.loopRunning("hatchwatch") and Hub.startLoop then
			Hub.startLoop("hatchwatch")
		end

		if not didSomething then
			loop.sendFailures = (loop.sendFailures or 0) + 1
			if loop.sendFailures == 1 then
				Hub.log("eggs: nichts gesendet - kein Remote erreichbar")
			end
			if loop.sendFailures >= MAX_REMOTE_FAILURES then
				Hub.log("eggs: kein Weg zum Hatchen gefunden, Loop aus")
				nativeNotify("Big Hub", "Hatchen geht nicht. 'Debug: Egg-Infos' druecken.", 10)
				loop.stop()
			end
			return
		end
		loop.sendFailures = 0

		Hub.eggProgress((loop.ticks * 13) % 100)
		Hub.countAction()
		Overlay.set("target", tostring(FC.Eggs.EggName) .. " x" .. tostring(amount))
		Overlay.pulse("hatche")
	end,

	onStop = function()
		local remote = Farm.remoteByName(FC.Eggs.DisableRemote)
		if remote then
			pcall(function()
				remote:FireServer()
			end)
			Hub.log("eggs: Auto-Hatch aus")
		end
		Hub.eggProgress(0)
	end,
}

--== Pet-Beobachter fuer den Webhook ==========================================
-- Vergleicht das Inventar mit dem Startstand. Jede neue UID = neues Pet.

Farm.hatchSeen = nil

Actions.hatchwatch = {
	interval = function()
		return 2
	end,

	onStart = function()
		Farm.hatchSeen = {}
		local pets = Mailbox.pets()
		local count = 0
		if pets then
			for _, info in ipairs(pets) do
				Farm.hatchSeen[tostring(info.uid)] = true
				count += 1
			end
		end
		Web.firstSent = false
		Web.queue = {}
		Web.totalSeen = 0

		Hub.log("webhook: beobachte Inventar, Startstand " .. count .. " Pets")
		Hub.log("webhook: URL " .. Web.masked() .. ", Modus " .. tostring(WH.Mode))
		if not Web.ready() then
			Hub.log("webhook: nicht sendebereit - URL eintragen oder Executor pruefen")
			nativeNotify("Big Hub", "Webhook nicht bereit. URL eintragen.", 8)
		end
		Overlay.set("status", "Pet-Webhook aktiv (" .. count .. " Pets)")
	end,

	step = function(loop)
		local pets, petErr = Mailbox.pets()
		if not pets then
			-- nicht still bleiben: sonst sieht man nicht, dass es haengt
			loop.readFailures = (loop.readFailures or 0) + 1
			if loop.readFailures <= 3 or loop.readFailures % 15 == 0 then
				Hub.log("webhook: Inventar nicht lesbar (" .. loop.readFailures
					.. "x) - " .. tostring(petErr))
			end
			return
		end
		loop.readFailures = 0

		if not Farm.hatchSeen then
			Farm.hatchSeen = {}
		end

		-- Lebenszeichen, damit man den Beobachter im Log sieht
		if loop.ticks % 15 == 0 then
			Hub.log("webhook: beobachte, " .. #pets .. " Pets im Inventar, "
				.. Web.totalSeen .. " neue bisher")
		end

		local fresh = {}
		for _, info in ipairs(pets) do
			local uid = tostring(info.uid)
			if uid ~= "" and not Farm.hatchSeen[uid] then
				Farm.hatchSeen[uid] = true
				table.insert(fresh, info)
			end
		end

		if #fresh > 0 then
			Hub.log("webhook: " .. #fresh .. " neue Pets erkannt")
			for _, info in ipairs(fresh) do
				Hub.log("   neu: " .. info.name .. " [" .. info.variant
					.. (info.shiny and ", shiny" or "") .. "]")
			end
			Overlay.set("target", "neu: " .. fresh[1].name
				.. (#fresh > 1 and (" +" .. (#fresh - 1)) or ""))
			Overlay.pulse("Pet geschluepft")
			Web.report(fresh)
			Hub.countAction()
		else
			Web.flush(false)
		end
	end,

	onStop = function()
		Web.flush(true)
		Hub.log("webhook: Beobachter aus, " .. Web.totalSeen .. " Pets gesehen")
	end,
}

--== Halloween Trick or Treat =================================================
-- Ablauf: Haeuser abfliegen -> Boss -> Pause -> von vorn.
-- Jede Phase meldet sich im Overlay, damit man sieht, wo er steht.

Farm.hw = { phase = "houses", index = 1, houses = {}, nextRun = 0, bossUntil = 0 }

Actions.halloween3 = {
	interval = function()
		return FC.Halloween.Interval or 1
	end,

	onStart = function()
		local hw = Farm.hw
		hw.phase = "houses"
		hw.index = 1
		hw.opened = 0
		hw.houses = {}

		local houses, instanceName = Farm.halloweenHouses()
		hw.houses = houses
		hw.instanceName = instanceName

		local limit = math.min(#houses, tonumber(FC.Halloween.MaxHouses) or 6)
		Hub.log("halloween: " .. #houses .. " Ziele gefunden, nehme " .. limit)
		Overlay.set("status", "Halloween: " .. limit .. " Haeuser")

		if #houses > 0 and houses[1].prompt then
			Hub.log("halloween: oeffne per 'Druecke E' (ProximityPrompt)")
			Hub.log("  erstes Ziel: " .. tostring(houses[1].text))
		end

		local action = FC.Halloween.Action
		if not action then
			local learned = Mailbox.learnedInstancing and instanceName
				and Mailbox.learnedInstancing[instanceName]
			action = learned and learned.action or nil
		end
		hw.action = action

		if #houses == 0 then
			Hub.log("halloween: nichts gefunden. Bist du im Event drin?")
			Farm.dumpPrompts(500)
			nativeNotify("Big Hub", "Keine Haeuser. Prompts stehen in der Konsole.", 10)
		end
	end,

	step = function(loop)
		local hw = Farm.hw
		local now = os.clock()
		local limit = tonumber(FC.Halloween.MaxHouses) or 6

		--== Phase: am Egg stehen und warten
		if hw.phase == "egg" then
			local left = math.max(hw.nextRun - now, 0)

			-- einmal hinfliegen, danach nur noch Position halten
			if hw.egg and hw.egg.Parent then
				local position = positionOf(hw.egg)
				local root = Util.root()
				if position and root then
					local away = (root.Position - (position + Vector3.new(0, 4, 0))).Magnitude
					if away > 12 then
						Util.glide(position + Vector3.new(0, 4, 0), FC.Halloween.FlySpeed or 120)
						hw.eggOpened = false
					end
				end

				-- einmal E am Egg: danach hatcht das Spiel von allein weiter
				if not hw.eggOpened then
					local ok = Farm.pressAt(hw.egg, "Egg " .. hw.egg.Name)
					hw.eggOpened = true
					Hub.log("halloween: Egg geoeffnet -> " .. tostring(ok))
					if ok then
						Hub.countAction()
					end
				end
			end

			Overlay.set("target", string.format("AFK am Egg, Haeuser in %d:%02d",
				math.floor(left / 60), math.floor(left % 60)))
			Overlay.pulse("AFK am Egg")

			if loop.ticks % 30 == 0 then
				Hub.log("halloween: AFK am Egg, noch " .. math.floor(left) .. "s")
			end

			if left <= 0 then
				hw.phase = "houses"
				hw.index = 1
				hw.opened = 0
				hw.houses = Farm.halloweenHouses()
				Hub.log("halloween: neue Runde, " .. #hw.houses .. " Ziele")
				Overlay.set("status", "Halloween: Haeuser")
			end
			return
		end

		--== Phase: Haeuser abklappern und E druecken
		if hw.phase == "houses" then
			if #hw.houses == 0 then
				hw.houses = Farm.halloweenHouses()
			end
			if #hw.houses == 0 then
				Overlay.set("target", "keine Haeuser gefunden")
				Overlay.pulse("suche Haeuser")
				-- alle 20 Durchlaeufe sagen, warum nichts passiert
				if loop.ticks % 20 == 0 then
					Hub.log("halloween: nichts gefunden. 'Halloween: Selbsttest' "
						.. "druecken - der sagt, woran es liegt.")
				end
				return
			end

			if loop.ticks < 3 then
				Hub.log("halloween: Phase Haeuser, " .. #hw.houses .. " Ziele, "
					.. "bei Nummer " .. hw.index .. ", " .. hw.opened .. " offen")
			end

			local house = hw.houses[hw.index]
			local gone = not house or not house.instance or not house.instance.Parent
				or (house.prompt and not house.prompt.Parent)

			if gone then
				hw.index += 1
			else
				Overlay.set("target", "Haus " .. hw.index .. "/" .. math.min(#hw.houses, limit)
					.. "  " .. tostring(house.name))
				Overlay.pulse("laufe zu Haus " .. hw.index)
				Farm.markTarget(house.instance)

				Util.glide(house.position + Vector3.new(0, 4, 0), FC.Halloween.FlySpeed or 120)

				-- DAS ist das Oeffnen: am Haus stehen und E druecken.
				-- Der Prompt wird hier vor Ort gesucht, weil er oft erst
				-- entsteht, wenn man nah dran ist.
				local opened, why = false, nil
				if house.prompt and house.prompt.Parent then
					opened, why = Farm.firePrompt(house.prompt)
					Hub.log("halloween: Haus " .. hw.index .. " E -> "
						.. (opened and "ok" or tostring(why)))
				end
				if not opened then
					opened, why = Farm.pressAt(house.instance, "Haus " .. hw.index)
				end

				-- zusaetzlich die gelernte Instanz-Aktion, falls bekannt
				if hw.action then
					local remote = Farm.remoteByName(FC.Halloween.Remote)
					if remote then
						local target = house.id or house.name
						pcall(function()
							remote:InvokeServer(hw.instanceName, hw.action, target, nil)
						end)
					end
				end

				if opened then
					hw.opened += 1
				end
				task.wait(FC.Halloween.HouseTime or 1.6)
				Hub.countAction()
				hw.index += 1
			end

			-- fertig, wenn genug Haeuser offen sind oder die Liste durch ist
			if hw.opened >= limit or hw.index > math.min(#hw.houses, limit) then
				Farm.markTarget(nil)
				Hub.log("halloween: " .. hw.opened .. " Haeuser geoeffnet, warte auf den Boss")
				Overlay.set("status", "Halloween: letzter Boss")
				hw.phase = "boss"
				hw.bossUntil = now + (FC.Halloween.BossTime or 120)
				hw.bossSearchUntil = now + (FC.Halloween.BossWait or 15)
			end
			return
		end

		--== Phase: nur der letzte Boss
		if hw.phase == "boss" then
			local boss = Farm.halloweenBoss()

			if not boss then
				Overlay.set("target", "warte auf den Boss")
				Overlay.pulse("warte auf Boss")
				if not FC.Halloween.AfkAtEgg then
					hw.egg = nil
				end
				if now >= hw.bossSearchUntil then
					Hub.log("halloween: kein Boss aufgetaucht, gehe zum Egg")
					hw.phase = "egg"
					hw.nextRun = now + (FC.Halloween.Cooldown or 720)
					hw.eggOpened = false
					hw.egg = Farm.findEgg(FC.Halloween.EggTarget)
					Overlay.set("status", "Halloween: AFK am Egg")
				end
				return
			end

			local position = positionOf(boss)
			if position then
				Farm.markTarget(boss)
				Overlay.set("target", "Boss " .. boss.Name)
				Overlay.pulse("kaempfe gegen Boss")
				Util.glide(position + Vector3.new(0, 6, 0), FC.Halloween.FlySpeed or 120)

				local damageRemote = Farm.remoteByName(FC.Breakables.DamageRemote)
				if damageRemote then
					pcall(function()
						damageRemote:FireServer(boss.Name)
					end)
				end
				Hub.countAction()
			end

			if now >= hw.bossUntil or not boss.Parent then
				Farm.markTarget(nil)
				Hub.log("halloween: Boss " .. (boss.Parent and "Zeit um" or "erledigt")
					.. ", " .. math.floor((FC.Halloween.Cooldown or 720) / 60)
					.. " Minuten AFK am Egg")
				hw.phase = "egg"
				hw.nextRun = now + (FC.Halloween.Cooldown or 720)
					hw.eggOpened = false

				if FC.Halloween.AfkAtEgg then
					local egg, eggErr = Farm.findEgg(FC.Halloween.EggTarget)
					hw.egg = egg
					if egg then
						Hub.log("halloween: Egg '" .. egg.Name .. "' gefunden")
					else
						Hub.log("halloween: " .. tostring(eggErr) .. " - bleibe stehen")
					end
				else
					hw.egg = nil
				end
				Overlay.set("status", "Halloween: AFK am Egg")
			end
			return
		end
	end,

	onStop = function()
		Farm.markTarget(nil)
		Hub.log("halloween: gestoppt in Phase " .. tostring(Farm.hw.phase)
			.. ", " .. tostring(Farm.hw.opened or 0) .. " Haeuser offen")
		Overlay.set("target", "-")
	end,
}

