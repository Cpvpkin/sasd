-- Alle Fenster der PlayerGui mit Anzahl Textfelder und Knoepfe.
-- Das Mailbox-Fenster ist das mit mindestens einem Textfeld.
function Mailbox.listGuis()
	local root = playerGui()
	if not root then
		Hub.log("keine PlayerGui")
		return
	end

	Hub.log("--- Fenster in der PlayerGui ---")
	local printed = 0
	for _, screen in ipairs(root:GetChildren()) do
		if screen:IsA("LayerCollector") and printed < 120 then
			local header = false
			for _, child in ipairs(screen:GetChildren()) do
				if child:IsA("GuiObject") and printed < 120 then
					local boxes, buttons = 0, 0
					for _, node in ipairs(child:GetDescendants()) do
						if node:IsA("TextBox") then
							boxes += 1
						elseif node:IsA("GuiButton") then
							buttons += 1
						end
					end
					if boxes > 0 or child.Visible then
						if not header then
							Hub.log(screen.Name .. "  (enabled=" .. tostring(screen.Enabled) .. ")")
							header = true
							printed += 1
						end
						Hub.log("    " .. child.Name
							.. "  sichtbar=" .. tostring(child.Visible)
							.. "  textfelder=" .. boxes
							.. "  knoepfe=" .. buttons)
						printed += 1
					end
				end
			end
		end
	end
	Hub.log("--- Ende Fenster (" .. printed .. " Zeilen) ---")
	nativeNotify("Big Hub", "Fensterliste in der Konsole.", 5)
end

-- Laeuft X Sekunden und meldet jedes Textfeld, das in der Zeit sichtbar wird.
-- Du druckst den Button und oeffnest dann die Mailbox im Spiel.
function Mailbox.watch(seconds)
	seconds = tonumber(seconds) or 20
	local root = playerGui()
	if not root then
		Hub.log("keine PlayerGui")
		return
	end

	Hub.status("Scanner laeuft - Mailbox JETZT oeffnen")
	nativeNotify("Big Hub", "Scanner laeuft " .. seconds .. "s. Mailbox JETZT im Spiel oeffnen!", 8)
	Hub.log("--- Fenster-Scanner, " .. seconds .. "s ---")

	local seen = {}
	for _, box in ipairs(renderedTextBoxes()) do
		seen[box] = true
	end
	Hub.log("beim Start sichtbar: " .. #renderedTextBoxes() .. " Textfelder")

	local deadline = os.clock() + seconds
	local found = 0

	while os.clock() < deadline do
		for _, box in ipairs(renderedTextBoxes()) do
			if not seen[box] then
				seen[box] = true
				found += 1
				local candidate = topWindow(box)
				Hub.log("NEU sichtbar: " .. box:GetFullName())
				Hub.log('   -> FramePath = "' .. pathFromPlayerGui(candidate) .. '",')
			end
		end
		task.wait(0.4)
	end

	Hub.log("--- Scanner fertig, " .. found .. " neue Textfelder ---")
	if found == 0 then
		Hub.log("Nichts gefunden. Moeglich: Mailbox war schon offen, oder das")
		Hub.log("Fenster hat kein Textfeld. Dann 'Fenster auflisten' benutzen.")
	end
	Hub.status("Scanner fertig, " .. found .. " Treffer")
	nativeNotify("Big Hub", "Scanner fertig: " .. found .. " Treffer. Konsole kopieren.", 7)
end

-- Aufbau der Spieldaten, zwei Ebenen tief. Damit finden wir die Pet-Liste.
function Mailbox.dumpSave()
	local data, err = Mailbox.save()
	if not data then
		Hub.log("save: " .. tostring(err))
		nativeNotify("Big Hub", tostring(err), 8)
		return
	end

	local function countOf(value)
		local count = 0
		for _ in pairs(value) do
			count += 1
		end
		return count
	end

	Hub.log("--- Aufbau der Spieldaten ---")
	for key, value in pairs(data) do
		if type(value) == "table" then
			Hub.log("  " .. tostring(key) .. " = table (" .. countOf(value) .. " Eintraege)")
			local shown = 0
			for subKey, subValue in pairs(value) do
				shown += 1
				if shown > 10 then
					Hub.log("      ... weitere")
					break
				end
				if type(subValue) == "table" then
					Hub.log("      " .. tostring(subKey) .. " = table ("
						.. countOf(subValue) .. ")  petartig="
						.. string.format("%.2f", looksLikePetList(subValue)))
				else
					Hub.log("      " .. tostring(subKey) .. " = " .. tostring(subValue))
				end
			end
		else
			Hub.log("  " .. tostring(key) .. " = " .. tostring(value)
				.. "  (" .. type(value) .. ")")
		end
	end

	local found, foundPath = findPetContainer(data)
	Hub.log("Pet-Liste laut Suche: " .. tostring(foundPath or "nichts gefunden"))
	Hub.log("--- Ende Spieldaten ---")
	nativeNotify("Big Hub", "Aufbau der Spieldaten in der Konsole.", 5)
end

function Mailbox.dumpPets()
