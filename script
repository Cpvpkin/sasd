local Util = {}

function Util.character()
	return LocalPlayer and LocalPlayer.Character
end

function Util.root()
	local char = Util.character()
	return char and char:FindFirstChild("HumanoidRootPart")
end

function Util.teleport(position)
	local root = Util.root()
	if not root then
		return false
	end
	root.CFrame = CFrame.new(position)
	return true
end

function Util.distanceTo(position)
	local root = Util.root()
	if not root then
		return math.huge
	end
	return (root.Position - position).Magnitude
end

function Util.area(name)
	for _, area in ipairs(CONFIG.Areas) do
		if area.name == name then
			return area
		end
	end
	return nil
end

function Util.areaNames()
	local names = {}
	for _, area in ipairs(CONFIG.Areas) do
		table.insert(names, area.name)
	end
	return names
end

function Util.wanted(typeName)
	for _, t in ipairs(State.FarmTargets or {}) do
		if t == typeName then
			return true
		end
	end
	return false
end

local function norm(value)
	local s = tostring(value or ""):lower()
	s = s:gsub("^%s+", ""):gsub("%s+$", "")
	return s
end

local function trim(value)
	local s = tostring(value or "")
	s = s:gsub("^%s+", ""):gsub("%s+$", "")
	return s
end

local function has(text, word)
	return norm(text):find(word, 1, true) ~= nil
end

