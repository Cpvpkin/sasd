-- Eigener Log-Puffer, unabhaengig von Rayfield. Daraus wird kopiert.
local LOG_BUFFER = {}
local LOG_MAX = 600

-- Diese Fassung laeuft ab der ersten Zeile des Scripts. Sie schreibt in den
-- Puffer und in die Executor-Konsole. Spaeter kommen Rayfield-Konsole und
-- Overlay dazu, der Puffer bleibt derselbe.
local function earlyLog(line)
	local text = os.date("[%H:%M:%S] ") .. tostring(line)
	pcall(print, "[BigHub] " .. text)
	table.insert(LOG_BUFFER, text)
	if #LOG_BUFFER > LOG_MAX then
		table.remove(LOG_BUFFER, 1)
	end
end

local Hub = {
	lines         = LOG_BUFFER,
	log           = earlyLog,
	notify        = function() end,
