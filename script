--== Filter ====================================================================

function Mailbox.rule(petName)
	local target = norm(petName)
	for _, rule in ipairs(MB.Pets or {}) do
		local ruleName = norm(rule.name)
		if ruleName ~= "" then
			if norm(rule.match) == "contains" then
				if target:find(ruleName, 1, true) then
					return rule
				end
			elseif ruleName == target then
				return rule
			end
		end
	end
	return nil
end

function Mailbox.wanted(info)
	if info.locked then
		if MB.SkipLocked then
			return false, "gesperrt"
		end
		if not MB.UnlockLocked then
			return false, "gesperrt (UnlockLocked ist aus)"
		end
		-- gesperrt, aber wird vor dem Senden geoeffnet
		info.needsUnlock = true
	end
	if MB.SkipEquipped and info.equipped then
		return false, "angelegt"
	end

	local mode = norm(MB.Mode)
	local rule = Mailbox.rule(info.name)

	if mode == "all" then
		return true, nil, { max = math.huge }
	end
	if mode == "blacklist" then
		if rule then
			return false, "auf der Blacklist"
		end
		return true, nil, { max = math.huge }
	end

	if not rule then
		return false, "nicht in CONFIG.Mailbox.Pets"
	end
	if rule.shinyOnly and not info.shiny then
		return false, "nicht shiny"
	end

	local variants = rule.variants
	if type(variants) == "table" and #variants > 0 then
		local hit = false
		for _, want in ipairs(variants) do
			local w = norm(want)
			if w == "any" or w == "alle" or w == info.variant then
				hit = true
				break
			end
		end
		if not hit then
			return false, "Variante " .. info.variant .. " nicht in der Liste"
		end
	end

	return true, nil, rule
end

function Mailbox.collect()
	local pets, err = Mailbox.pets()
	if not pets then
		return nil, err
	end

	local matched, reasons = {}, {}

	-- 1. alles sammeln, was durch den Filter kommt
	for _, info in ipairs(pets) do
		local ok, why, rule = Mailbox.wanted(info)
		if not ok then
			reasons[info.name] = why
		elseif Mailbox.sentUids[tostring(info.uid)] then
			reasons[info.name] = "in dieser Sitzung schon gesendet"
		elseif Mailbox.cannotMail[tostring(info.uid)] then
			reasons[info.name] = "Server: " .. tostring(Mailbox.cannotMail[tostring(info.uid)])
		else
			info.priority = tonumber(rule and rule.priority) or 0
			table.insert(matched, info)
		end
	end

	-- 2. nach Prioritaet sortieren: Titanic vor Huge
	table.sort(matched, function(a, b)
		if a.priority ~= b.priority then
			return a.priority > b.priority
		end
		return a.name < b.name
	end)

	-- 3. erst jetzt die Grenzen anwenden, damit die Prioritaet entscheidet
	local chosen, perName = {}, {}
	local limit = tonumber(MB.MaxPerMail) or 0
	if limit <= 0 then
		limit = math.huge
	end

	for _, info in ipairs(matched) do
		if #chosen >= limit then
			reasons[info.name] = "Grenze MaxPerMail (" .. tostring(MB.MaxPerMail) .. ") erreicht"
		else
			local rule = Mailbox.rule(info.name)
			local cap = tonumber(rule and rule.max) or math.huge
			local used = perName[info.key] or 0
			if used < cap then
				perName[info.key] = used + 1
				table.insert(chosen, info)
			else
				reasons[info.name] = "max " .. tostring(cap) .. " erreicht"
			end
		end
	end

	Mailbox.lastReasons = reasons
	return chosen, nil, #pets
end

--== Slots im Fenster ==========================================================

local function firstLabelText(instance)
	for _, child in ipairs(instance:GetDescendants()) do
		if child:IsA("TextLabel") and trim(child.Text) ~= "" then
			return child.Text
		end
	end
	return nil
end

function Mailbox.slots()
	local frame, sendFrame, err = Mailbox.frames()
	if not frame then
		return nil, err
	end

	local roots = {}
	if sendFrame then
		table.insert(roots, sendFrame)
	end
	table.insert(roots, frame)

	for _, root in ipairs(roots) do
		local slots = {}
		for _, child in ipairs(root:GetDescendants()) do
			if child:IsA("GuiButton") then
				local text = firstLabelText(child) or child.Name
				if text and trim(text) ~= "" then
					table.insert(slots, {
						button = child,
						text   = text,
						key    = norm(text),
						name   = norm(child.Name),
					})
				end
			end
		end
		if #slots > 0 then
			return slots
		end
	end

	return nil, "keine anklickbaren Elemente gefunden"
end

function Mailbox.slotFor(info, slots)
	for _, slot in ipairs(slots) do
		if slot.key == info.key or slot.key:find(info.key, 1, true) then
			return slot
		end
	end
	return nil
end

local SEND_WORDS = { "senden", "versenden", "send", "confirm", "bestaetigen" }
local CONFIRM_WORDS = { "confirm", "bestaetigen", "ja", "yes", "ok" }

local function findWordButton(slots, words)
	for _, slot in ipairs(slots) do
		for _, word in ipairs(words) do
			if slot.key:find(word, 1, true) or slot.name:find(word, 1, true) then
				return slot
			end
		end
	end
	return nil
end

--== Schritt 2: Felder fuellen =================================================

function Mailbox.prepare()
	local to = trim((MB.Recipient ~= "" and MB.Recipient) or State.MailTo)
	if to == "" then
		Hub.status("Abbruch: kein Empfaenger eingetragen")
		nativeNotify("Big Hub", "Kein Empfaenger. Username im Mailbox-Tab eintragen.", 6)
		return false
	end

	local message = (MB.Message ~= "" and MB.Message) or State.MailMessage or ""
	if tostring(message):find("[^\32-\126]") then
		Hub.status("Abbruch: Nachricht hat Sonderzeichen")
		nativeNotify("Big Hub", "Nachricht enthaelt ungueltige Zeichen.", 6)
		return false
	end

	local frame, sendFrame, err, source = Mailbox.frames()
	if not frame then
		Hub.status("Abbruch: Mailbox-Fenster nicht gefunden (" .. tostring(err) .. ")")
		nativeNotify("Big Hub", "Mailbox-Fenster nicht gefunden. Debug-Dump schicken.", 8)
		return false
	end
	Hub.log("mailbox: Fenster gefunden ueber " .. tostring(source) .. " -> " .. frame:GetFullName())

	local okVisible, visible = pcall(function()
		return frame.Visible
	end)
	if okVisible and visible == false then
		Hub.status("Abbruch: Mailbox ist im Spiel nicht offen")
		nativeNotify("Big Hub", "Mailbox erst im Spiel am Postkasten oeffnen.", 6)
		return false
	end

	if not sendFrame then
		Hub.status("Abbruch: Sendebereich nicht gefunden")
		nativeNotify("Big Hub", "Sendebereich nicht gefunden. Debug-Dump schicken.", 8)
		return false
	end

	local userInput, msgInput, boxes = Mailbox.inputs(sendFrame)
	Hub.log("mailbox: " .. #boxes .. " Textfelder im Sendebereich")

	if not userInput then
		Hub.status("Abbruch: kein Textfeld fuer den Empfaenger")
		nativeNotify("Big Hub", "Kein Eingabefeld gefunden. Debug-Dump schicken.", 8)
		return false
	end

	local okUser, got = setInput(userInput, to)
	Hub.log("mailbox: Empfaenger -> " .. tostring(got) .. (okUser and " (ok)" or " (NICHT uebernommen)"))

	if msgInput and message ~= "" then
		setInput(msgInput, message)
	end

	return true
end

--== Senden per Remote (der richtige Weg) =====================================

local function findRemoteByName(name)
	local network = ReplicatedStorage:FindFirstChild("Network")
	if network then
		local direct = network:FindFirstChild(name)
		if direct then
			return direct
		end
	end
	for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
		if child.Name == name
			and (child:IsA("RemoteFunction") or child:IsA("RemoteEvent")) then
			return child
		end
	end
	return nil
end

-- Das Relay, das der Client beim Senden benutzt. Der Spion merkt sich die
-- echte Instanz, falls der Name im Spiel mal wechselt.
function Mailbox.relay()
	if Mailbox.relayInstance and Mailbox.relayInstance.Parent then
		return Mailbox.relayInstance
	end
	local remote = findRemoteByName(MB.RelayRemote)
	if remote then
		Mailbox.relayInstance = remote
		Hub.log("relay: " .. remote:GetFullName() .. " <" .. remote.ClassName .. ">")
		return remote
	end
	return nil, "Remote '" .. tostring(MB.RelayRemote) .. "' nicht gefunden"
end

function Mailbox.sendViaRemote()
	Hub.log("=== Senden per Remote ===")
	Hub.status("laeuft...")
	nativeNotify("Big Hub", "Senden gestartet...", 3)

	local to = trim((MB.Recipient ~= "" and MB.Recipient) or State.MailTo)
	if to == "" then
		Hub.status("Abbruch: kein Empfaenger")
		nativeNotify("Big Hub", "Kein Empfaenger eingetragen.", 6)
		return false
	end

	local remote, relayErr = Mailbox.relay()

	-- Relay weg? Dann das normale Mailbox-Remote versuchen.
	if not remote then
		Hub.log("relay: " .. tostring(relayErr) .. " - versuche '"
			.. tostring(MB.SendRemote) .. "'")
		remote = Farm.remoteByName(MB.SendRemote)
	end

	if not remote then
		Hub.status("Abbruch: kein Sende-Remote gefunden")
		Hub.log("mailbox: weder '" .. tostring(MB.RelayRemote) .. "' noch '"
			.. tostring(MB.SendRemote) .. "' gefunden")
		Hub.log("  -> 'Debug: ALLES mitlesen' starten und ein Pet per Hand senden,")
		Hub.log("     dann merkt sich der Hub das richtige Remote.")
		nativeNotify("Big Hub", "Kein Sende-Remote gefunden. Siehe Log.", 10)
		return false
	end

	Hub.log("mailbox: sende ueber " .. remote:GetFullName()
		.. " <" .. remote.ClassName .. ">")
	if not remote:IsA("RemoteFunction") then
		Hub.log("relay: ist ein " .. remote.ClassName .. ", erwartet war RemoteFunction")
	end

	-- Inventar offen halten: ohne Eintraege kann kein Schloss aufgemacht werden
	if MB.UnlockLocked then
		local opened, how = Mailbox.openInventory()
		Hub.log("inventar: " .. tostring(how))
		if not opened then
			Hub.log("inventar: bitte im Spiel oeffnen, sonst bleiben Schloesser dran")
		end
		if MB.KeepInventoryOpen then
			Mailbox.keepInventoryOpen(true)
		end
	end

	local chosen, collectErr, total = Mailbox.collect()
	if not chosen then
		Hub.status("Abbruch: " .. tostring(collectErr))
		nativeNotify("Big Hub", tostring(collectErr), 8)
		return false
	end

	Hub.log("mailbox: " .. #chosen .. " von " .. tostring(total) .. " Pets passen zur Config")

	if #chosen == 0 then
		local shown = 0
		for name, why in pairs(Mailbox.lastReasons) do
			Hub.log("  - " .. name .. ": " .. tostring(why))
			shown += 1
			if shown >= 10 then
				break
			end
		end
		Hub.status("kein Pet passt zur Config")
		nativeNotify("Big Hub", "Kein Pet passt zu CONFIG.Mailbox.Pets.", 7)
		return false
	end

	local message = (MB.Message ~= "" and MB.Message) or State.MailMessage or ""
	local sent, rejected, failed, skipped, unknown = 0, 0, 0, 0, 0
	local unlockLogged = 0
	local rejectStreak = 0
	local rejectReasons = {}

	for _, info in ipairs(chosen) do
		local uid = tostring(info.uid or "")

		-- Schutz: ohne echte UID wird nichts verschickt
		if #uid < 8 then
			skipped += 1
			Hub.log("  uebersprungen: " .. info.name .. " - keine brauchbare UID ('" .. uid .. "')")
		elseif MB.DryRun then
			Hub.log("  TESTLAUF: " .. info.name .. "  uid=" .. uid)
		else
			local label = info.name .. " [" .. info.variant
				.. (info.shiny and ", shiny" or "") .. "]"

			-- erst das Schloss weg, sonst nimmt der Server die Sendung nicht
			if info.needsUnlock or info.locked then
				-- erkanntes Schloss: erst der Weg, der per Hand funktioniert
				local unlocked, how = Mailbox.unlockAlways(info)
				if not unlocked then
					unlocked, how = Mailbox.unlock(info)
				end
				Hub.log("  Schloss bei " .. label .. ": "
					.. (unlocked and ("offen (" .. tostring(how) .. ")")
						or ("bleibt zu - " .. tostring(how))))
				if not unlocked then
					skipped += 1
					Overlay.set("target", "Schloss bei " .. info.name .. " nicht offen")
					continue
				end
			elseif MB.UnlockLocked and MB.UnlockAlways then
				-- Schloss nicht erkannt: trotzdem entsperren, schadet nicht
				local okUnlock, how = Mailbox.unlockAlways(info)
				-- nur die ersten drei loggen, sonst wird das Log unleserlich
				if unlockLogged < 3 then
					unlockLogged += 1
					Hub.log("  vorsorglich entsperrt: " .. label .. " -> "
						.. (okUnlock and tostring(how) or ("ging nicht: " .. tostring(how))))
				end
			end

			-- alle Rueckgabewerte einsammeln, nicht nur den ersten
			local results = table.pack(pcall(function()
				return remote:InvokeServer(to, message, MB.ItemClass, uid, 1)
			end))

			if not results[1] then
				failed += 1
				Hub.log("  FEHLER bei " .. label .. ": " .. tostring(results[2]))
				if MB.StopOnFailure then
					Hub.log("  -> Abbruch (StopOnFailure)")
					break
				end
			else
				local answer = {}
				for index = 2, results.n do
					table.insert(answer, tostring(results[index])
						.. " (" .. typeof(results[index]) .. ")")
				end
				local answerText = #answer > 0 and table.concat(answer, ", ") or "nichts"
				Hub.log("  Aufruf durch: " .. label .. "  uid=" .. uid
					.. "  antwort=" .. answerText)

				-- Die Wahrheit steht im Inventar, nicht in der Antwort
				if MB.Verify then
					task.wait(MB.VerifyDelay or 1.2)
					local owned = Mailbox.ownsUid(uid)
					if owned == false then
						sent += 1
						rejectStreak = 0
						Mailbox.sentUids[uid] = true
						Hub.log("    bestaetigt: Pet ist aus dem Inventar verschwunden")
						Hub.countAction()
					elseif owned == true then
						rejected += 1
						rejectStreak += 1

						-- Grund des Servers merken und dieses Pet nicht nochmal
						-- probieren, wenn er es grundsaetzlich ablehnt
						local reason = answerText
						rejectReasons[reason] = (rejectReasons[reason] or 0) + 1
						if norm(reason):find("can't mail", 1, true)
							or norm(reason):find("cant mail", 1, true) then
							Mailbox.cannotMail[uid] = reason
						end

						Hub.log("    ABGELEHNT (" .. rejectStreak .. " in Folge): "
							.. info.name .. " bleibt im Inventar")

						if MB.StopOnFailure or rejectStreak >= (tonumber(MB.MaxRejects) or 5) then
							Hub.log("    -> Abbruch nach " .. rejectStreak
								.. " Ablehnungen in Folge")
							break
						end
					else
						unknown += 1
						Hub.log("    unklar: Inventar nicht pruefbar")
					end
				else
					sent += 1
					Mailbox.sentUids[uid] = true
					Hub.countAction()
				end
			end
			task.wait(MB.SendDelay or 0.6)
		end
	end

	local summary
	if MB.DryRun then
		summary = "Testlauf: " .. #chosen .. " Pets waeren rausgegangen"
	else
		summary = sent .. " bestaetigt verschickt"
		if rejected > 0 then
			summary = summary .. ", " .. rejected .. " vom Server abgelehnt"
		end
		if failed > 0 then
			summary = summary .. ", " .. failed .. " Aufruf-Fehler"
		end
		if skipped > 0 then
			summary = summary .. ", " .. skipped .. " ohne UID"
		end
		if unknown > 0 then
			summary = summary .. ", " .. unknown .. " unklar"
		end
	end

	-- Waechter aus, das Inventar darf wieder zugehen
	Mailbox.keepInventoryOpen(false)

	Hub.log("=== " .. summary .. " ===")
	Hub.status(summary)
	nativeNotify("Big Hub", summary .. " an " .. to, 8)

	-- Was hat der Server genau gesagt?
	local anyReason = false
	for reason, count in pairs(rejectReasons) do
		anyReason = true
		Hub.log("Server-Antwort " .. count .. "x: " .. tostring(reason))
	end

	if rejected > 0 and sent == 0 then
		Hub.log("Der Server nimmt die Sendung nicht an. Haeufigste Gruende:")
		Hub.log("  1. Pet ist ANGELEGT - angelegte Pets kann man nicht mailen")
		Hub.log("  2. Pet ist gesperrt und das Schloss ging nicht weg")
		Hub.log("  3. Pet ist nicht handelbar (Event- oder Exklusiv-Pets)")
		Hub.log("  4. Tageslimit der Mailbox - 'Debug: MailLog dumpen'")
		Hub.log("  5. Empfaenger falsch geschrieben: '" .. to .. "'")
		if anyReason then
			Hub.log("Die Server-Antwort oben sagt, welcher Grund es ist.")
		end
	end

	return sent > 0 or MB.DryRun
end

--== Senden ueber die Spiel-UI (Reserve) ======================================

function Mailbox.sendViaGui()
	Hub.log("=== Senden gestartet (UI-Weg) ===")
	Hub.status("laeuft...")
	nativeNotify("Big Hub", "Senden gestartet...", 3)

	if not Mailbox.prepare() then
		return false
	end

	local chosen, err, total = Mailbox.collect()
	if not chosen then
		Hub.status("Abbruch: " .. tostring(err))
		nativeNotify("Big Hub", tostring(err), 8)
		return false
	end

	Hub.log("mailbox: " .. #chosen .. " von " .. tostring(total) .. " Pets passen zur Config")
	for _, info in ipairs(chosen) do
		Hub.log("  + " .. info.name .. " [" .. info.variant .. (info.shiny and ", shiny" or "") .. "]")
	end

	if #chosen == 0 then
		local shown = 0
		for name, why in pairs(Mailbox.lastReasons) do
			Hub.log("  - " .. name .. ": " .. tostring(why))
			shown += 1
			if shown >= 10 then
				break
			end
		end
		Hub.status("kein Pet passt zur Config")
		nativeNotify("Big Hub", "Kein Pet passt zur Liste in CONFIG.Mailbox.Pets.", 7)
		return false
	end

	if MB.DryRun then
		Hub.status("Testlauf: " .. #chosen .. " Pets wuerden raus")
		nativeNotify("Big Hub", "Testlauf: " .. #chosen .. " Pets. Nichts angeklickt.", 6)
		return true
	end

	if not Mailbox.canClick() then
		Hub.status("Felder gefuellt, Executor kann nicht klicken")
		nativeNotify("Big Hub", "Felder sind gefuellt. Pets und Senden musst du selbst klicken.", 8)
		return false
	end

	local slots, slotErr = Mailbox.slots()
	if not slots then
		Hub.status("Abbruch: " .. tostring(slotErr))
		nativeNotify("Big Hub", "Pet-Slots nicht gefunden. Debug-Dump schicken.", 8)
		return false
	end
	Hub.log("mailbox: " .. #slots .. " anklickbare Elemente")

	local attached, missed = 0, {}
	for _, info in ipairs(chosen) do
		local slot = Mailbox.slotFor(info, slots)
		if slot then
			local okClick, clickErr = clickGui(slot.button)
			if okClick then
				attached += 1
				Hub.countAction()
			else
				Hub.log("mailbox: Klick auf " .. info.name .. " fehlgeschlagen: " .. tostring(clickErr))
			end
		else
			table.insert(missed, info.name)
		end
		task.wait(MB.StepDelay or 0.12)
	end

	Hub.log("mailbox: " .. attached .. " Pets angehaengt")
	if #missed > 0 then
		Hub.log("mailbox: kein Slot fuer: " .. table.concat(missed, ", "))
	end

	if attached == 0 then
		Hub.status("nichts angehaengt, Slots passen nicht")
		nativeNotify("Big Hub", "Pets im Fenster nicht gefunden. Debug-Dump schicken.", 8)
		return false
	end

	if not MB.AutoConfirm then
		Hub.status(attached .. " Pets ausgewaehlt, Senden klickst du")
		nativeNotify("Big Hub", attached .. " Pets ausgewaehlt. Jetzt Senden klicken.", 7)
		return true
	end

	local sendSlot = findWordButton(slots, SEND_WORDS)
	if not sendSlot then
		Hub.status(attached .. " Pets dran, Senden-Knopf nicht gefunden")
		nativeNotify("Big Hub", attached .. " Pets dran. Senden selbst klicken.", 7)
		return false
	end

	local okSend, sendErr = clickGui(sendSlot.button)
	Hub.log("mailbox: Senden geklickt (" .. sendSlot.text .. ") -> " .. tostring(okSend))

	-- manche Spiele fragen danach nochmal nach
	task.wait(0.4)
	local after = Mailbox.slots()
	if after then
		local confirmSlot = findWordButton(after, CONFIRM_WORDS)
		if confirmSlot and confirmSlot.button ~= sendSlot.button then
			clickGui(confirmSlot.button)
			Hub.log("mailbox: Bestaetigung geklickt (" .. confirmSlot.text .. ")")
		end
	end

	Hub.status(okSend and ("abgeschickt: " .. attached .. " Pets") or ("Senden fehlgeschlagen: " .. tostring(sendErr)))
	nativeNotify("Big Hub", okSend and (attached .. " Pets an " .. trim((MB.Recipient ~= "" and MB.Recipient) or State.MailTo)) or tostring(sendErr), 6)
	return okSend
end

-- Welcher Weg genommen wird, steht in CONFIG.Mailbox.UseRemote
function Mailbox.send()
	if MB.UseRemote then
		return Mailbox.sendViaRemote()
	end
	return Mailbox.sendViaGui()
end

--== Debug =====================================================================

local function dumpTree(instance, depth, maxDepth, lines, limit)
	if #lines >= limit then
		return
	end
	for _, child in ipairs(instance:GetChildren()) do
		if #lines >= limit then
			return
		end
		local text = ""
		if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then
			text = ' "' .. tostring(child.Text) .. '"'
		end
		table.insert(lines, string.rep("  ", depth) .. child.Name
			.. " <" .. child.ClassName .. ">" .. text)
		if depth < maxDepth then
			dumpTree(child, depth + 1, maxDepth, lines, limit)
		end
	end
end

function Mailbox.dumpGui()
	local frame, sendFrame, err, source = Mailbox.frames()
	if not frame then
