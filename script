-- Das offene Inventarfenster selbst finden. Wichtig: daran wird erkannt, ob
-- schon offen ist - sonst klickt der Hub den Umschalter und macht es wieder zu.
local INVENTORY_FRAME_WORDS = { "inventory", "inventar", "backpack", "rucksack" }

function Mailbox.inventoryFrame()
	local root = playerGui()
	if not root then
		return nil
	end

	for _, child in ipairs(root:GetDescendants()) do
		if child:IsA("GuiObject") and child.Visible then
			local name = norm(child.Name)
			local hit = false
			for _, word in ipairs(INVENTORY_FRAME_WORDS) do
				if name:find(word, 1, true) then
					hit = true
					break
				end
			end
			if hit and isRendered(child) then
				-- gross genug, um ein Fenster zu sein
				local okSize, size = pcall(function()
					return child.AbsoluteSize
				end)
				if okSize and size and size.X > 200 and size.Y > 150 then
					return child
				end
			end
		end
	end
	return nil
end

-- Ist das Inventar offen? Erst das Fenster, dann die Pet-Eintraege.
function Mailbox.inventoryOpen()
	local frame = Mailbox.inventoryFrame()
	if frame then
		return true, "Fenster " .. frame.Name
	end

	local pets = Mailbox.pets()
	if not pets or #pets == 0 then
		return false, "keine Pets lesbar"
	end
	if Mailbox.petEntryButton(pets[1]) then
		return true, "Pet-Eintraege sichtbar"
	end
	if pets[2] and Mailbox.petEntryButton(pets[2]) then
		return true, "Pet-Eintraege sichtbar"
	end
	return false, "kein Inventarfenster und keine Eintraege"
end

