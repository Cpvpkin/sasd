local function positionOf(instance)
	if not instance then
		return nil
	end
	if instance:IsA("BasePart") then
		return instance.Position
	end
	if instance:IsA("Model") then
		if instance.PrimaryPart then
			return instance.PrimaryPart.Position
		end
		local ok, cf = pcall(function()
			return instance:GetPivot()
		end)
		if ok and cf then
			return cf.Position
		end
		local part = instance:FindFirstChildWhichIsA("BasePart", true)
		return part and part.Position or nil
	end
	local part = instance:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

--== Zonen =====================================================================

-- Zonennamen aus dem Save (UnlockedZones), sonst aus der Workspace
function Farm.zoneNamesFromSave()
	local data = Mailbox.save()
	if type(data) ~= "table" then
		return {}
	end
	local unlocked = data.UnlockedZones
	if type(unlocked) ~= "table" then
		return {}
	end

	local names = {}
	for name, value in pairs(unlocked) do
		if type(name) == "string" and (value == true or not FC.Zones.OnlyUnlocked) then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

-- Weg 1: einen Zonen-Ordner in der Workspace finden und dessen Kinder nehmen.
-- Das ist zuverlaessiger als Namensabgleich, weil die Objekte im Spiel anders
-- heissen koennen als die Schluessel im Save.
local ZONE_WORDS = { "zones", "zone", "areas", "area", "islands", "worlds" }

function Farm.zonesFromWorkspace()
	local best, bestCount

	local function consider(node)
		local key = norm(node.Name)
		-- Hilfsordner des Spiels sind keine Zonenliste
		if key:find("fake", 1, true) or key:find("break", 1, true)
			or key:find("render", 1, true) then
			return
		end
		for _, word in ipairs(ZONE_WORDS) do
			if key == word or key:find(word, 1, true) then
				local count = 0
				for _, child in ipairs(node:GetChildren()) do
					if positionOf(child) then
						count += 1
					end
				end
				if count >= 3 and (not bestCount or count > bestCount) then
					best, bestCount = node, count
				end
				return
			end
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		consider(child)
		for _, sub in ipairs(child:GetChildren()) do
			consider(sub)
		end
	end

	if not best then
		return {}, "kein Zonen-Ordner in der Workspace"
	end

	local zones = {}
	for _, child in ipairs(best:GetChildren()) do
		local position = positionOf(child)
		if position then
			table.insert(zones, {
				name = child.Name,
				position = position,
				path = child:GetFullName(),
			})
		end
	end

	Hub.log("zonen: Ordner " .. best:GetFullName() .. " mit " .. #zones .. " Zonen")
	return zones
end

-- Weg 2: Zonennamen aus dem Save in der Workspace suchen.
function Farm.scanZones()
	-- erst der Ordner-Weg
	local fromWorkspace = Farm.zonesFromWorkspace()
	if #fromWorkspace > 0 then
		Farm.zones = fromWorkspace
		local areas = {}
		for _, zone in ipairs(fromWorkspace) do
			table.insert(areas, { name = zone.name, position = zone.position })
		end
		CONFIG.Areas = areas
		return fromWorkspace
	end

	local names = Farm.zoneNamesFromSave()
	if #names == 0 then
		Hub.log("zonen: keine UnlockedZones in den Spieldaten")
		return {}
	end

	local wanted = {}
	for _, name in ipairs(names) do
		wanted[norm(name)] = name
	end

	local found = {}
	for _, child in ipairs(workspace:GetDescendants()) do
		local key = norm(child.Name)
		if wanted[key] and not found[key] then
			local position = positionOf(child)
			if position then
				found[key] = {
					name = wanted[key],
					position = position,
					path = child:GetFullName(),
				}
			end
		end
	end

	local zones = {}
	for _, name in ipairs(names) do
		local entry = found[norm(name)]
		if entry then
			table.insert(zones, entry)
		end
	end

	Farm.zones = zones
	Hub.log("zonen: " .. #zones .. " von " .. #names .. " in der Workspace gefunden")

	-- die echten Zonen ersetzen die Platzhalter-Areas
	if #zones > 0 then
		local areas = {}
		for _, zone in ipairs(zones) do
			table.insert(areas, { name = zone.name, position = zone.position })
		end
		CONFIG.Areas = areas
	end

	return zones
end

function Farm.zoneOrder()
	if #Farm.zones == 0 then
		Farm.scanZones()
	end
	if #(FC.Zones.Order or {}) == 0 then
		return Farm.zones
	end

	local byName = {}
	for _, zone in ipairs(Farm.zones) do
		byName[norm(zone.name)] = zone
	end
	local ordered = {}
	for _, name in ipairs(FC.Zones.Order) do
		local zone = byName[norm(name)]
		if zone then
			table.insert(ordered, zone)
		end
	end
	return #ordered > 0 and ordered or Farm.zones
end

--== Breakables ================================================================

local BREAKABLE_WORDS = { "breakable", "breakables", "destructible", "coinjar", "jar" }

-- Container in der Workspace finden, in dem die Breakables liegen
function Farm.breakableContainer()
	if FC.Breakables.Container then
		local node = workspace
		for part in tostring(FC.Breakables.Container):gmatch("[^%.]+") do
			node = node:FindFirstChild(part)
			if not node then
				return nil, "Pfad '" .. tostring(FC.Breakables.Container) .. "' nicht gefunden"
			end
		end
		return node
	end

	if Farm.breakableCache and Farm.breakableCache.Parent then
		return Farm.breakableCache
	end

	local best, bestCount = nil, 0
	local function consider(node)
		local key = norm(node.Name)
		for _, word in ipairs(BREAKABLE_WORDS) do
			if key:find(word, 1, true) then
				local count = #node:GetChildren()
				if count > bestCount then
					best, bestCount = node, count
				end
				return
			end
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		consider(child)
		for _, sub in ipairs(child:GetChildren()) do
			consider(sub)
			for _, subsub in ipairs(sub:GetChildren()) do
				consider(subsub)
			end
		end
	end

	if best then
		Farm.breakableCache = best
		Hub.log("breakables: Container " .. best:GetFullName() .. " (" .. bestCount .. " Objekte)")
		return best
	end
	return nil, "kein Breakable-Container in der Workspace gefunden"
end

-- Naechstes Ziel innerhalb des Radius, das nicht das letzte war
function Farm.nearestBreakable()
	local container, err = Farm.breakableContainer()
	if not container then
		return nil, err
	end

	local root = Util.root()
	if not root then
		return nil, "kein Charakter"
	end

	local here = root.Position
	local best, bestDistance
	for _, child in ipairs(container:GetChildren()) do
		local position = positionOf(child)
		if position then
			local distance = (position - here).Magnitude
			if distance <= (FC.Breakables.Radius or 400)
				and (not bestDistance or distance < bestDistance)
				and child ~= Farm.lastTarget then
				best, bestDistance = child, distance
			end
		end
	end

	if not best then
		return nil, "kein Ziel im Radius " .. tostring(FC.Breakables.Radius)
	end
	return best, nil, bestDistance
end

