local CLICK_SIGNALS = { "MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up" }

local function clickGui(button)
	if not button then
		return false, "kein Button"
	end

	local fired = 0

	if type(getconnections) == "function" then
		for _, signalName in ipairs(CLICK_SIGNALS) do
			local okSignal, signal = pcall(function()
				return button[signalName]
			end)
			if okSignal and signal then
				local okCons, connections = pcall(getconnections, signal)
				if okCons and type(connections) == "table" then
					for _, connection in ipairs(connections) do
						pcall(function()
							connection:Fire()
						end)
						fired += 1
					end
				end
			end
		end
	end

	if fired == 0 and type(firesignal) == "function" then
		if pcall(firesignal, button.MouseButton1Click) then
			fired += 1
		end
	end

	if fired == 0 then
		return false, "Executor kann keine GUI-Klicks senden"
	end
	return true
end

-- Das Spiel liest ein Textfeld erst, wenn der Fokus verloren geht.
local function setInput(box, value)
	if not box then
