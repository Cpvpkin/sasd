function Mailbox.inventoryButtons()
	local root = playerGui()
	if not root then
		return {}
	end

	local out = {}
	for _, child in ipairs(root:GetDescendants()) do
		if child:IsA("GuiButton") and isRendered(child) then
			-- nur der eigene Name und der eigene Text zaehlen, damit nicht
			-- jeder Knopf in einem Fenster mit "Pets" im Titel passt
			local text = child.Name
			if child:IsA("TextButton") and child.Text ~= "" then
				text = text .. " " .. child.Text
			end
			local lower = norm(text)

			local deny = false
			for _, word in ipairs(INVENTORY_DENY) do
				if lower:find(word, 1, true) then
					deny = true
					break
				end
			end

			if not deny then
				for index, word in ipairs(MB.InventoryWords or {}) do
					if lower:find(word, 1, true) then
						-- fruehere Woerter in der Liste sind die besseren
						table.insert(out, {
							button = child,
							score = 100 - index,
							text = text,
							path = child:GetFullName(),
						})
						break
					end
				end
			end
		end
	end

	table.sort(out, function(a, b)
		return a.score > b.score
	end)
	return out
end

-- Oeffnet das Inventar und prueft danach, ob Eintraege da sind
-- Pfad unter der PlayerGui aufloesen
local function resolveGuiPath(path)
	local root = playerGui()
	if not root or not path or trim(path) == "" then
		return nil
	end
	local node = root
	for part in tostring(path):gmatch("[^%.]+") do
		if norm(part) ~= "playergui" then
			node = node:FindFirstChild(part)
			if not node then
				return nil, "'" .. part .. "' nicht gefunden"
			end
		end
	end
	return node
end

-- Merkt sich, welches Fenster aufgeht, wenn DU das Inventar oeffnest.
-- Danach kann der Hub es ohne Klick wieder sichtbar machen.
function Mailbox.learnInventory(seconds)
	seconds = tonumber(seconds) or 15

	local root = playerGui()
	if not root then
		Hub.log("lernen: keine PlayerGui")
		return
	end

	local function bigVisible()
		local set = {}
		for _, child in ipairs(root:GetDescendants()) do
			if child:IsA("GuiObject") and child.Visible and isRendered(child) then
				local okSize, size = pcall(function()
					return child.AbsoluteSize
				end)
				if okSize and size and size.X > 250 and size.Y > 200 then
					set[child] = true
				end
			end
		end
		return set
	end

	local before = bigVisible()
	Hub.log("=== Inventar lernen, " .. seconds .. "s ===")
	Hub.log("Oeffne JETZT das Inventar im Spiel, von Hand.")
	nativeNotify("Big Hub", "Inventar jetzt im Spiel oeffnen (" .. seconds .. "s).", 10)

	local deadline = os.clock() + seconds
	local found

	while os.clock() < deadline and not found do
		task.wait(0.3)
		for node in pairs(bigVisible()) do
			if not before[node] then
				found = node
				break
			end
		end
	end

	if not found then
		Hub.log("lernen: kein neues Fenster gesehen")
		nativeNotify("Big Hub", "Nichts gelernt. Nochmal versuchen.", 7)
		return
	end

	-- Pfad ab PlayerGui bauen
	local parts, node = {}, found
	while node and node ~= root do
		table.insert(parts, 1, node.Name)
		node = node.Parent
	end
	local path = table.concat(parts, ".")

	MB.InventoryFramePath = path
	Hub.log("lernen: Inventar ist " .. found:GetFullName())
	Hub.log('Trag das in die Config ein:  InventoryFramePath = "' .. path .. '",')
	Hub.log("Fuer diese Sitzung ist es schon gesetzt.")
	nativeNotify("Big Hub", "Inventar gelernt. Pfad steht im Log.", 9)
end

function Mailbox.openInventory()
	-- Zuerst nachsehen! Der Knopf im HUD ist ein Umschalter: ein Klick bei
	-- offenem Inventar macht es zu.
	local already, why = Mailbox.inventoryOpen()
	if already then
		return true, "war schon offen (" .. tostring(why) .. ")"
	end

	-- Weg 1: gelerntes Fenster einfach sichtbar machen. Klickt nichts an,
	-- kann also auch nichts ablegen oder verkaufen.
	if trim(MB.InventoryFramePath) ~= "" then
		local frame, pathErr = resolveGuiPath(MB.InventoryFramePath)
		if frame then
			local ok = pcall(function()
				local node = frame
				while node and node:IsA("GuiObject") do
					node.Visible = true
					node = node.Parent
				end
				if node and node:IsA("LayerCollector") then
					node.Enabled = true
				end
			end)
			task.wait(0.3)
			if Mailbox.inventoryOpen() then
				return true, "ueber den gelernten Pfad sichtbar gemacht"
			end
			return false, "gelerntes Fenster liess sich nicht zeigen (" .. tostring(ok) .. ")"
		end
		Hub.log("inventar: gelernter Pfad passt nicht mehr - " .. tostring(pathErr))
	end

	-- Weg 2: HUD-Knopf klicken. Nur wenn ausdruecklich erlaubt, weil hier
	-- schon mal der falsche Knopf getroffen wurde.
	if not MB.AutoOpenInventory then
		return false, "Inventar bitte im Spiel oeffnen (Auto-Klick ist aus)"
	end

	local candidates = Mailbox.inventoryButtons()
	if #candidates == 0 then
		return false, "kein Inventar-Knopf im HUD gefunden"
	end

	for index = 1, math.min(#candidates, 4) do
		local candidate = candidates[index]
		local ok = clickGui(candidate.button)
		Hub.log("inventar: klicke '" .. candidate.text:sub(1, 30) .. "' -> "
			.. (ok and "ok" or "ging nicht"))

		if ok then
			for _ = 1, 6 do
				task.wait(0.15)
				if Mailbox.inventoryOpen() then
					return true, "geoeffnet ueber '" .. candidate.text:sub(1, 30) .. "'"
				end
			end
		end
	end

	return false, "Inventar liess sich nicht oeffnen"
end

--== Waechter: Inventar offen halten ==========================================

Mailbox.keepOpen = false

function Mailbox.keepInventoryOpen(value)
	if value == false then
		Mailbox.keepOpen = false
		return
	end
	if Mailbox.keepOpen then
		return
	end

	Mailbox.keepOpen = true
	Hub.log("inventar: Waechter an, haelt es offen")

	task.spawn(function()
		local reopened = 0
		while Mailbox.keepOpen do
			task.wait(1)
			if not Mailbox.keepOpen then
				break
			end
			local open = Mailbox.inventoryOpen()
			if not open then
				reopened += 1
				Hub.log("inventar: war zu, oeffne wieder (" .. reopened .. ")")
				local ok, how = Mailbox.openInventory()
				if not ok then
					Hub.log("inventar: " .. tostring(how))
				end
			end
		end
		Hub.log("inventar: Waechter aus, " .. reopened .. " mal nachgeoeffnet")
	end)
end

