local actionCount = 0

-- Darf unter keinen Umstaenden werfen: sonst stirbt die aufrufende Funktion.
Hub.log = function(line)
	local text = os.date("[%H:%M:%S] ") .. tostring(line)
	pcall(print, "[BigHub] " .. text)

	-- eigener Puffer, damit "Diagnose kopieren" immer funktioniert
	table.insert(LOG_BUFFER, text)
	if #LOG_BUFFER > LOG_MAX then
		table.remove(LOG_BUFFER, 1)
	end

	pcall(function()
		console:Append(text)
	end)

	pcall(function()
		local short = tostring(line)
		if #short > 44 then
			short = short:sub(1, 44) .. "..."
		end
		Overlay.set("last", short)
	end)
end

-- Zeigt im Overlay, welche Loops gerade laufen
local function refreshOverlayLoops()
	local running = {}
	for name, loop in pairs(loops) do
		if loop.running then
			table.insert(running, name)
		end
	end
	table.sort(running)
	Overlay.set("loops", #running > 0 and table.concat(running, ", ") or "nichts")
	if #running == 0 then
		pcall(function()
			Overlay.title.Text = CONFIG.Name .. "  |  bereit"
		end)
	end
end

Hub.refreshLoops = refreshOverlayLoops

Hub.notify = function(cfg)
	cfg = cfg or {}
	Hub.log("notify: " .. tostring(cfg.title) .. " - " .. tostring(cfg.content))
	if windowHas("Notify") then
		pcall(window.Notify, window, cfg)
	else
		nativeNotify(cfg.title, cfg.content, cfg.duration)
	end
end

Hub.toast = function(cfg)
	cfg = cfg or {}
	Hub.log("toast: " .. tostring(cfg.title) .. " - " .. tostring(cfg.subtitle))
	if windowHas("Toast") then
		pcall(window.Toast, window, cfg)
	elseif windowHas("Notify") then
		pcall(window.Notify, window, { title = cfg.title, content = cfg.subtitle, icon = cfg.icon })
	else
		nativeNotify(cfg.title, cfg.subtitle, cfg.duration)
	end
end

-- Status-Zeile im Mailbox-Tab. Schlaegt das Setzen fehl, bleibt die Konsole.
Hub.status = function(text)
	Hub.log("status: " .. tostring(text))
	Overlay.set("status", text)
	for _, method in ipairs({ "Set", "SetText", "Update" }) do
		if type(mailStatus[method]) == "function" then
			local ok = pcall(function()
				mailStatus[method](mailStatus, { text = tostring(text) })
			end)
			if not ok then
				ok = pcall(function()
					mailStatus[method](mailStatus, tostring(text))
				end)
			end
			if ok then
				return
			end
		end
	end
end

Hub.farmProgress = function(value)
	pcall(function()
		farmProgress:Set(value)
		farmStat:Set(loops.farm.ticks)
	end)
end

Hub.eggProgress = function(value)
	pcall(function()
		eggProgress:Set(value)
		eggStat:Set(loops.eggs.ticks)
	end)
end

Hub.countAction = function()
	actionCount += 1
	pcall(function()
		actionStat:Set(actionCount)
	end)
	Overlay.set("actions", actionCount)
	Overlay.pulse()
end

Hub.stopAllLoops = stopAllLoops

-- Log in die Zwischenablage. Unabhaengig von Rayfields Konsole.
Hub.copyLog = function(count)
	count = tonumber(count) or 200
	local from = math.max(#LOG_BUFFER - count + 1, 1)
	local part = {}
	for index = from, #LOG_BUFFER do
		table.insert(part, LOG_BUFFER[index])
	end
	local text = table.concat(part, "\n")

	if type(setclipboard) ~= "function" then
		nativeNotify("Big Hub", "Dein Executor kann nicht kopieren. Log steht im Main-Tab.", 9)
		return false, 0
	end

	local ok = pcall(setclipboard, text)
	if ok then
		nativeNotify("Big Hub", #part .. " Zeilen kopiert. Jetzt einfuegen.", 8)
		Overlay.set("status", #part .. " Zeilen kopiert")
	else
		nativeNotify("Big Hub", "Kopieren fehlgeschlagen.", 7)
	end
	return ok, #part
end

--------------------------------------------------------------------------------
-- Laufzeit-Stat
--------------------------------------------------------------------------------

task.spawn(function()
	local start = os.clock()
	while not window.unloaded do
		task.wait(1)
		if window.unloaded then
			break
		end
		pcall(function()
			runtimeStat:Set(math.floor(os.clock() - start))
		end)

		-- Lebenszeichen: solange ein Loop laeuft, dreht sich das Zeichen weiter
		local anyRunning = false
		for _, loop in pairs(loops) do
			if loop.running then
				anyRunning = true
				break
			end
		end
		if anyRunning then
			Overlay.pulse()
		end
	end
end)

