-- NUR Click. Down und Up zusaetzlich zu feuern loest in PS99 das
-- Aus- und Anlegen aus - das hat Pets abgelegt.
local RIGHT_SIGNALS = { "MouseButton2Click" }

local function rightClickGui(button)
	if not button then
		return false, "kein Button"
	end
	local fired = 0

	if type(getconnections) == "function" then
		for _, signalName in ipairs(RIGHT_SIGNALS) do
			local okSignal, signal = pcall(function()
				return button[signalName]
			end)
			if okSignal and signal then
				local okCons, connections = pcall(getconnections, signal)
				if okCons and type(connections) == "table" then
					for _, connection in ipairs(connections) do
						pcall(function()
							connection:Fire()
						end)
						fired += 1
					end
				end
			end
		end
	end

	if fired == 0 and type(firesignal) == "function" then
		if pcall(firesignal, button.MouseButton2Click) then
			fired += 1
		end
	end

	if fired == 0 then
		return false, "Rechtsklick nicht moeglich"
	end
	return true
end

-- Den Eintrag eines Pets im offenen Inventar finden
function Mailbox.petEntryButton(info)
	local root = playerGui()
	if not root then
		return nil, "keine PlayerGui"
	end

	local uid = tostring(info.uid or "")
	local byName

	-- Bereiche, in denen nicht geklickt werden darf: dort legt ein Klick
	-- Pets an oder ab, statt das Kontextmenue zu oeffnen.
	local denyPath = { "equip", "hotbar", "slot", "team", "loadout", "best" }

	for _, child in ipairs(root:GetDescendants()) do
		if child:IsA("GuiButton") and isRendered(child) then
			local path = norm(child:GetFullName())
			local blocked = false
			for _, word in ipairs(denyPath) do
				if path:find(word, 1, true) then
					blocked = true
					break
				end
			end
			if blocked then
				continue
			end
			-- 1. Treffer ueber die UID, das ist eindeutig
			if uid ~= "" then
				if child.Name == uid then
					return child, "UID im Namen"
				end
				local okFind, hit = pcall(function()
					return child:FindFirstChild(uid, true)
				end)
				if okFind and hit then
					return child, "UID im Eintrag"
				end
			end

			-- 2. sonst ueber den Pet-Namen im Text, eine Ebene tief
			if not byName then
				for _, label in ipairs(child:GetChildren()) do
					if label:IsA("TextLabel") and label.Text ~= ""
						and has(label.Text, info.name) then
						byName = child
						break
					end
				end
			end
		end
	end

	if byName then
		return byName, "Pet-Name im Text"
	end
	return nil, "kein Eintrag im Inventar gefunden"
end

-- Alle sichtbaren Knoepfe, deren Text auf "Freischalten" passt
function Mailbox.unlockButton()
	local root = playerGui()
	if not root then
		return nil
	end

	for _, child in ipairs(root:GetDescendants()) do
		if child:IsA("GuiButton") and isRendered(child) then
			local text = child.Name
			if child:IsA("TextButton") and child.Text ~= "" then
				text = text .. " " .. child.Text
			end
			for _, label in ipairs(child:GetDescendants()) do
				if label:IsA("TextLabel") and label.Text ~= "" then
					text = text .. " " .. label.Text
				end
			end
			-- nie einen Ablegen-Knopf treffen
			local lower = norm(text)
			local bad = false
			for _, word in ipairs({ "equip", "ablegen", "abnehmen", "anlegen",
				"sell", "verkauf", "delete", "loesch" }) do
				if lower:find(word, 1, true) then
					bad = true
					break
				end
			end

			if not bad then
				for _, word in ipairs(MB.UnlockWords or {}) do
					if has(text, word) then
						return child, text
					end
				end
			end
		end
	end
	return nil
end

