-- Echten Tastendruck schicken. Fuer Spiele, die ihr eigenes "Druecke E"
-- zeichnen und die Taste selbst abfragen, statt einen ProximityPrompt zu nutzen.
local KEY_CODES = { E = 0x45, F = 0x46, Q = 0x51, R = 0x52, T = 0x54, Space = 0x20 }

function Util.pressKey(keyName, hold)
	keyName = keyName or "E"
	hold = hold or 0.12

	local enumKey = Enum.KeyCode[keyName] or Enum.KeyCode.E

	local okVim = pcall(function()
		local vim = game:GetService("VirtualInputManager")
		vim:SendKeyEvent(true, enumKey, false, game)
		task.wait(hold)
		vim:SendKeyEvent(false, enumKey, false, game)
	end)
	if okVim then
		return true, "VirtualInputManager"
	end

	local code = KEY_CODES[keyName]
	if code and type(keypress) == "function" then
		local okPress = pcall(function()
			keypress(code)
			task.wait(hold)
			if type(keyrelease) == "function" then
				keyrelease(code)
			end
		end)
		if okPress then
			return true, "keypress"
		end
	end

	return false, "Executor kann keine Tasten schicken"
end

-- Gleitet zum Ziel statt zu blinken, und schaut es dabei an.
function Util.glide(position, speed)
	local root = Util.root()
	if not root then
		return false
	end

	local from = root.Position
	local distance = (position - from).Magnitude
	if distance < 1 then
		return true
	end

	local duration = math.clamp(distance / math.max(speed or 140, 10), 0.05, 2)
	local start = os.clock()

	while true do
		local alpha = (os.clock() - start) / duration
		if alpha >= 1 then
			break
		end
		local current = Util.root()
		if not current then
			return false
		end
		local point = from:Lerp(position, alpha)
		local okCf = pcall(function()
			current.CFrame = CFrame.new(point, position)
		end)
		if not okCf then
			current.CFrame = CFrame.new(point)
		end
		task.wait(0.03)
	end

	local final = Util.root()
	if final then
		pcall(function()
			final.CFrame = CFrame.new(position, position + (position - from).Unit)
		end)
	end
	return true
end

