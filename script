create(mailTab, "CreateButton", {
	name = "ENTSPERREN + SENDEN",
	description = "Inventar auf, Schloesser weg, dann alles raus",
	icon = "unlock-keyhole",
	callback = function()
		Hub.log("################ ENTSPERREN + SENDEN ################")
		Overlay.set("status", "entsperren + senden")

		-- 1. Inventar auf und offen halten
		local opened, how = Mailbox.openInventory()
		Hub.log("1. Inventar: " .. tostring(how))
		Mailbox.keepInventoryOpen(true)

		-- 2. alle passenden Pets entsperren
		local chosen, err, total = Mailbox.collect()
		if not chosen then
			Hub.log("2. " .. tostring(err))
			nativeNotify("Big Hub", tostring(err), 8)
			return
		end
		Hub.log("2. " .. #chosen .. " von " .. tostring(total) .. " Pets passen zur Config")

		local unlocked, failed = 0, 0
		for index, info in ipairs(chosen) do
			local ok, why = Mailbox.unlockAlways(info)
			if ok then
				unlocked += 1
			else
				failed += 1
				if failed <= 3 then
					Hub.log("   Schloss bei " .. info.name .. ": " .. tostring(why))
				end
			end
			if index % 10 == 0 then
				Overlay.set("target", "entsperre " .. index .. "/" .. #chosen)
			end
		end
		Hub.log("3. entsperrt: " .. unlocked .. ", fehlgeschlagen: " .. failed)

		-- 3. senden
		Hub.log("4. Versand startet")
		Mailbox.send()
	end,
})

