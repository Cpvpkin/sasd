--[[ ==========================================================================
	  Technik - UI, Key, Loops
   ========================================================================== ]]

local unlocked = false

local function hasAccess()
	return (not CONFIG.RequireKey) or unlocked
end

local Stub = {}
Stub.__index = function(_, key)
	if key == "value" then
		return nil
	end
	return function() end
end
local function stub()
	return setmetatable({}, Stub)
end

local function shallowCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
	end
	return out
end

local failures = 0
local gatedElements = {}

local function create(container, method, cfg)
	cfg = cfg and shallowCopy(cfg) or {}

	local needsAccess = cfg.locked == true
	cfg.locked = nil

	local element
	local userCallback = cfg.callback

	if type(userCallback) == "function" then
		cfg.callback = function(...)
			if needsAccess and not hasAccess() then
				Hub.toast({
					title = "Key benoetigt",
					subtitle = 'Tab "Key" oeffnen',
					icon = "key-round",
					duration = 3,
				})
				nativeNotify("Big Hub", "Key benoetigt - Tab 'Key'.", 5)
				if method == "CreateToggle" and element then
					pcall(function()
						element:Set(false)
					end)
				end
				return
			end

			local args = { ... }
			local label = tostring(cfg.name or method)

			-- Jeder Klick landet im Log. Damit ist nachvollziehbar, was du
			-- gedrueckt hast und was danach passiert ist.
			local shownArgs = {}
			for index = 1, math.min(#args, 2) do
				local value = args[index]
				if type(value) ~= "table" then
					table.insert(shownArgs, tostring(value))
				else
					table.insert(shownArgs, "(" .. #value .. " Werte)")
				end
			end
			Hub.log(">>> KLICK: " .. label
				.. (#shownArgs > 0 and ("  [" .. table.concat(shownArgs, ", ") .. "]") or ""))

			task.spawn(function()
				local ok, err = pcall(userCallback, table.unpack(args))
				if ok then
					Hub.log("<<< fertig: " .. label)
				end
				if not ok then
					warn("[BigHub] Callback '" .. label .. "': " .. tostring(err))
					Hub.log("fehler in '" .. label .. "': " .. tostring(err))
					Hub.toast({
						title = "Fehler in " .. label,
						subtitle = "Details in der Konsole",
						icon = "octagon-alert",
						duration = 5,
					})
					nativeNotify("Big Hub Fehler", label .. ": " .. tostring(err), 10)
				end
			end)
		end
	end

	local fn = container[method]
	if type(fn) ~= "function" then
		failures += 1
		warn("[BigHub] " .. method .. " existiert nicht in dieser Rayfield-Version")
		return stub()
	end

	local ok, result = pcall(fn, container, cfg)

	if (not ok or not result) and cfg.icon ~= nil then
		local retry = shallowCopy(cfg)
		retry.icon = nil
		local ok2, result2 = pcall(fn, container, retry)
		if ok2 and result2 then
			warn("[BigHub] Icon '" .. tostring(cfg.icon) .. "' abgelehnt bei '"
				.. tostring(cfg.name) .. "'")
			ok, result = true, result2
		end
	end

	if not ok or not result then
		failures += 1
		warn("[BigHub] " .. method .. " fehlgeschlagen ('" .. tostring(cfg.name)
			.. "'): " .. tostring(result))
		return stub()
	end

	element = result

	if needsAccess and CONFIG.VisualLock and CONFIG.RequireKey
		and method ~= "CreateButton" then
		table.insert(gatedElements, element)
		pcall(function()
			element:Lock("Key benoetigt")
		end)
	end

	return element
end

local window

local function windowHas(method)
	return type(window) == "table" and type(window[method]) == "function"
end

-- Das Rayfield-Fenster findet man ueber seine ScreenGui. Damit laesst sich
-- das Hauptmenue ausblenden, bis der Key eingegeben ist.
local function rayfieldScreen()
	if KeyGui.rayfield and KeyGui.rayfield.Parent then
		return KeyGui.rayfield
	end

	local places = {}
	if type(gethui) == "function" then
		local ok, hidden = pcall(gethui)
		if ok and hidden then
			table.insert(places, hidden)
		end
	end
	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		table.insert(places, coreGui)
	end
	local playerGuiInstance = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGuiInstance then
		table.insert(places, playerGuiInstance)
	end

	local words = { "rayfield", "sirius", "gen2" }
	for _, place in ipairs(places) do
		local ok, children = pcall(function()
			return place:GetChildren()
		end)
		if ok then
			for _, child in ipairs(children) do
				if child:IsA("ScreenGui") and child.Name ~= "BigHubKey"
					and child.Name ~= "BigHubOverlay" then
					local name = norm(child.Name)
					for _, word in ipairs(words) do
						if name:find(word, 1, true) then
							KeyGui.rayfield = child
							return child
						end
					end
				end
			end
		end
	end
	return nil
end

-- Liest Farben, Schrift und Ecken aus dem laufenden Rayfield-Fenster ab.
-- Muss aufgerufen werden, SOLANGE das Hauptmenue noch sichtbar ist.
local function sampleMenuTheme()
	local theme = {}
	local screen = rayfieldScreen()
	if not screen then
		return theme, "nicht gefunden, nehme Standardfarben"
	end

	local descendants = {}
	local okList = pcall(function()
		descendants = screen:GetDescendants()
	end)
	if not okList then
		return theme, "nicht lesbar"
	end

	-- groesste sichtbare Flaeche = das Fenster selbst
	local best, bestArea
	for _, child in ipairs(descendants) do
		if child:IsA("Frame") and child.Visible and child.BackgroundTransparency < 0.95 then
			local size = child.AbsoluteSize
			local area = size.X * size.Y
			if area > (bestArea or 0) then
				best, bestArea = child, area
			end
		end
	end

	if best then
		theme.bg = best.BackgroundColor3
		theme.bgAlpha = best.BackgroundTransparency
		local corner = best:FindFirstChildOfClass("UICorner")
		if corner then
			theme.corner = corner.CornerRadius
		end
		local stroke = best:FindFirstChildOfClass("UIStroke")
		if stroke then
			theme.stroke = stroke.Color
			theme.thickness = stroke.Thickness
		end
	end

	-- Schrift und Textfarbe vom ersten echten Text
	for _, child in ipairs(descendants) do
		if child:IsA("TextLabel") and child.Visible and trim(child.Text) ~= "" then
			theme.text = child.TextColor3
			theme.font = child.Font
			break
		end
	end
	for _, child in ipairs(descendants) do
		if child:IsA("TextLabel") and child.Visible
			and child.Font == Enum.Font.GothamBold then
			theme.fontBold = child.Font
			break
		end
	end

	-- Flaechenfarbe von einem Knopf oder Eingabefeld
	for _, child in ipairs(descendants) do
		if (child:IsA("TextButton") or child:IsA("TextBox") or child:IsA("ImageButton"))
			and child.Visible and child.BackgroundTransparency < 0.9 then
			theme.surface = child.BackgroundColor3
			break
		end
	end

	-- Akzent: die auffaelligste Farbe eines kleinen Elements
	for _, child in ipairs(descendants) do
		if child:IsA("Frame") and child.Visible and child.BackgroundTransparency < 0.5 then
			local color = child.BackgroundColor3
			local _, saturation, value = Color3.toHSV(color)
			if saturation > 0.4 and value > 0.4 then
				theme.accent = color
				break
			end
		end
	end

	local found = {}
	for key in pairs(theme) do
		table.insert(found, key)
	end
	return theme, "vom Hauptmenue (" .. table.concat(found, ", ") .. ")"
end

local function setMenuVisible(value)
	-- erst die saubere Methode, falls diese Rayfield-Version sie hat
	for _, method in ipairs({ value and "Show" or "Hide", "SetVisible", "Toggle" }) do
		if windowHas(method) then
			local ok = pcall(function()
				if method == "SetVisible" or method == "Toggle" then
					window[method](window, value)
				else
					window[method](window)
				end
			end)
			if ok then
				return true, method
			end
		end
	end

	local screen = rayfieldScreen()
	if screen then
		local ok = pcall(function()
			screen.Enabled = value
		end)
		if ok then
			return true, "ScreenGui " .. screen.Name
