local function toggleLoop(name, value)
	if value then
		if not State.Master then
			State.Master = true
			if masterToggle then
				pcall(function()
					masterToggle:Set(true)
				end)
			end
			Hub.log("master automatisch an fuer '" .. name .. "'")
		end
		startLoop(name)
	else
		stopLoop(name)
	end
end

--------------------------------------------------------------------------------
-- Key-Logik
--------------------------------------------------------------------------------

local function fetchRemoteKey()
	if not CONFIG.KeyUrl then
		return nil
	end
	local ok, body = pcall(game.HttpGet, game, CONFIG.KeyUrl)
	if ok and type(body) == "string" then
		return (body:gsub("%s+$", ""))
	end
	return nil
end

local function isValidKey(input)
	input = trim(input)
	if input == "" then
		return false
	end
	local remote = fetchRemoteKey()
	if remote then
		return input == remote
	end
	for _, k in ipairs(CONFIG.Keys) do
		if input == k then
			return true
		end
	end
	return false
end

local function readSavedKey()
	if not CONFIG.KeySave then
		return nil
	end
	local ok, content = pcall(function()
		if isfile and isfile(CONFIG.KeyFile) then
			return readfile(CONFIG.KeyFile)
		end
		return nil
	end)
	return ok and content or nil
end

local function writeSavedKey(key)
	if not CONFIG.KeySave then
		return
	end
	pcall(function()
		if writefile then
			writefile(CONFIG.KeyFile, key)
		end
	end)
end

--------------------------------------------------------------------------------
-- Key-Gate VOR dem Hauptmenue
--------------------------------------------------------------------------------
-- Hier gibt es noch kein Rayfield-Fenster. Erst wenn der Key stimmt, laeuft
-- das Script weiter und baut das Hauptmenue - vorher ist nichts zu sehen.

local preUnlocked = false
local preSource = nil

if CONFIG.RequireKey then
	local saved = readSavedKey()

	if saved and isValidKey(saved) then
		preUnlocked = true
		preSource = "saved"
		Hub.log("key: gespeicherter Key akzeptiert")
	else
		local accepted = false

		KeyGui.build({
			link = CONFIG.KeyLink,
			onSubmit = function(text)
				if not isValidKey(text) then
					Hub.log("key: falscher Key eingegeben")
					return false
				end
				writeSavedKey(text)
				accepted = true
				return true
			end,
		})

		-- Ist das Fenster wirklich auf dem Schirm? Ein gebautes, aber
		-- unsichtbares Fenster wuerde das Script endlos warten lassen.
		local visible = false
		if KeyGui.gui then
			task.wait(0.3)
			local okSize, size = pcall(function()
				local frame = KeyGui.gui:FindFirstChildWhichIsA("Frame")
				return frame and frame.AbsoluteSize or nil
			end)
			visible = okSize and size ~= nil and size.X > 50 and size.Y > 50
			Hub.log("key: Fenster sichtbar = " .. tostring(visible)
				.. (size and ("  " .. math.floor(size.X) .. "x" .. math.floor(size.Y)) or ""))
			if not visible then
				Hub.log("key: Fenster ist nicht sichtbar, zeige stattdessen den Key-Tab")
				KeyGui.close()
			end
		end

		if visible then
			nativeNotify("Big Hub", "Enter your license key.", 10)
			Hub.log("key: warte auf Eingabe, Hauptmenue wird noch nicht gebaut")

			-- Nie endlos warten: nach der Zeit geht es mit dem Key-Tab weiter.
			local waitUntil = os.clock() + (tonumber(CONFIG.KeyTimeout) or 120)
			while not accepted do
				if not KeyGui.gui or not KeyGui.gui.Parent then
					Hub.log("key: Fenster ist verschwunden, kein Zugang")
					break
				end
				if os.clock() > waitUntil then
					Hub.log("key: nach " .. tostring(CONFIG.KeyTimeout or 120)
						.. "s keine Eingabe, baue das Hauptmenue mit Key-Tab")
					KeyGui.close()
					break
				end
				task.wait(0.1)
			end

			if accepted then
				KeyGui.close()
				preUnlocked = true
				preSource = "input"
				Hub.log("key: akzeptiert, baue das Hauptmenue")
			end
		else
			-- eigenes Fenster nicht moeglich: dann wie frueher ueber den Tab
			Hub.log("key: eigenes Fenster ging nicht, benutze den Key-Tab")
		end
	end
end

