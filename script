--== Hatch-Menue: den Knopf mit der hoechsten Anzahl druecken ================

local HATCH_WORDS = { "hatch", "open", "oeffnen", "egg", "buy", "kaufen" }

-- Alle sichtbaren Knoepfe, aus deren Text sich eine Anzahl lesen laesst.
-- "x28" oder "28x" zaehlt als sicherer Treffer und kommt vor allem anderen.
function Farm.hatchButtons()
	local root = playerGui()
	if not root then
		return {}
	end

	local out = {}
	for _, child in ipairs(root:GetDescendants()) do
		if child:IsA("GuiButton") and isRendered(child) then
			local text = child.Name
			if child:IsA("TextButton") and child.Text ~= "" then
				text = text .. " " .. child.Text
			end
			for _, label in ipairs(child:GetDescendants()) do
				if label:IsA("TextLabel") and label.Text ~= "" then
					text = text .. " " .. label.Text
				end
			end

			local lower = norm(text)
			local amount, strong = nil, false

			local marked = lower:match("x%s*(%d+)") or lower:match("(%d+)%s*x")
			if marked then
				amount, strong = tonumber(marked), true
			end

			if not amount then
				for _, word in ipairs(HATCH_WORDS) do
					if lower:find(word, 1, true) then
						amount = tonumber(lower:match("(%d+)"))
						break
					end
				end
			end

			if amount and amount > 0 and amount <= 1000 then
				table.insert(out, {
					button = child,
					amount = amount,
					strong = strong,
					text = text,
					path = child:GetFullName(),
				})
			end
		end
	end

	table.sort(out, function(a, b)
		if a.strong ~= b.strong then
			return a.strong
		end
		return a.amount > b.amount
	end)
	return out
end

