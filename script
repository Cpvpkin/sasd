-- Library.Client direkt zu requiren schlaegt in PS99 fehl ("Requested module
-- experienced an error"), weil das Modul nur ueber Library initialisiert wird.
-- Darum mehrere Wege, erster Treffer wird gemerkt.
local libraryCache

local function requireClientLibrary()
	if libraryCache then
		return libraryCache
	end

	local attempts = {
		{ "Library -> .Client", function()
			local lib = require(ReplicatedStorage.Library)
			return type(lib) == "table" and lib.Client or nil
		end },
		{ "Library.Client", function()
			return require(ReplicatedStorage.Library.Client)
		end },
		{ "Library.Client.Save", function()
			local save = require(ReplicatedStorage.Library.Client.Save)
			return type(save) == "table" and { Save = save } or nil
		end },
		{ "Library (Save drin)", function()
			local lib = require(ReplicatedStorage.Library)
			if type(lib) == "table" and lib.Save then
				return { Save = lib.Save }
			end
			return nil
		end },
		{ "geladene Module", function()
			if type(getloadedmodules) ~= "function" then
				return nil
			end
			for _, module in ipairs(getloadedmodules()) do
				if module.Name == "Client" and module.Parent and module.Parent.Name == "Library" then
					local ok, result = pcall(require, module)
					if ok and type(result) == "table" then
						return result
					end
				end
			end
			return nil
		end },
	}

	local problems = {}
	for _, attempt in ipairs(attempts) do
		local ok, result = pcall(attempt[2])
		if ok and type(result) == "table" then
			Hub.log("library: geladen ueber '" .. attempt[1] .. "'")
			libraryCache = result
			return result
		end
		table.insert(problems, attempt[1] .. " -> " .. tostring(result))
	end

	return nil, table.concat(problems, " | ")
end

-- Letzter Ausweg: das Save-Table im Speicher suchen
local function saveFromMemory()
	if not MB.MemoryScan then
		return nil, "Speicher-Scan aus (CONFIG.Mailbox.MemoryScan = true)"
	end
	if type(getgc) ~= "function" then
		return nil, "getgc fehlt"
	end

	local ok, objects = pcall(getgc, true)
	if not ok or type(objects) ~= "table" then
		return nil, "getgc lieferte nichts"
	end

	local checked = 0
	for _, obj in ipairs(objects) do
		if type(obj) == "table" then
			checked += 1
			local okInv, inventory = pcall(function()
				return rawget(obj, "Inventory")
			end)
			if okInv and type(inventory) == "table" then
				local pets = rawget(inventory, "pets") or rawget(inventory, "Pets")
				if type(pets) == "table" and next(pets) ~= nil then
					Hub.log("save: im Speicher gefunden (nach " .. checked .. " Tabellen)")
					return obj
				end
			end
		end
		if checked > 400000 then
			break
		end
	end

	return nil, "kein Save-Table im Speicher"
end

-- Weg 1: ueber die Spiel-Library
local function frameFromLibrary()
	local attempts = {
		function()
			return require(ReplicatedStorage.Library.Client.GUI)
		end,
		function()
			local client = requireClientLibrary()
			return client and client.GUI
		end,
	}

	local GUI
	for _, fn in ipairs(attempts) do
		local ok, result = pcall(fn)
		if ok and type(result) == "table" then
			GUI = result
			break
		end
	end
	if not GUI then
		return nil, "Library.Client.GUI nicht ladbar"
	end

	local ok, machine = pcall(function()
		if type(GUI.MailboxMachine) == "function" then
			return GUI.MailboxMachine()
		end
		return GUI.MailboxMachine
	end)
	if not ok or type(machine) ~= "table" or not machine.Frame then
		return nil, "MailboxMachine ohne Frame"
	end
	return machine.Frame, nil
end

local function playerGui()
	return LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

-- Pfad eines Elements, so wie er in CONFIG.FramePath gehoert
local function pathFromPlayerGui(gui)
	local root = playerGui()
	local parts, node = {}, gui
	while node and node ~= root do
		table.insert(parts, 1, node.Name)
		node = node.Parent
	end
	return table.concat(parts, ".")
end

-- Weg 0: Pfad aus der Config
local function frameFromConfigPath()
	local path = MB.FramePath
	if not path or trim(path) == "" then
		return nil, "FramePath nicht gesetzt"
	end
	local root = playerGui()
	if not root then
		return nil, "keine PlayerGui"
	end

	local node = root
	for part in tostring(path):gmatch("[^%.]+") do
		local lower = norm(part)
		if lower ~= "playergui" and lower ~= "game" and lower ~= "players" then
			local nextNode = node:FindFirstChild(part)
			if not nextNode then
				return nil, "'" .. part .. "' nicht unter " .. node.Name
			end
			node = nextNode
		end
	end
	return node, nil
end

-- Ist das Element wirklich auf dem Schirm? (alle Eltern sichtbar)
local function isRendered(gui)
	local node = gui
	while node and node:IsA("GuiObject") do
		if not node.Visible then
			return false
		end
		node = node.Parent
	end
	if node and node:IsA("LayerCollector") then
		return node.Enabled
	end
	return true
end

local function renderedTextBoxes()
	local root = playerGui()
	if not root then
		return {}
	end
	local boxes = {}
	for _, child in ipairs(root:GetDescendants()) do
		if child:IsA("TextBox") and isRendered(child) then
			table.insert(boxes, child)
		end
	end
	return boxes
end

-- vom Textfeld hoch bis direkt unter die ScreenGui = das Fenster
local function topWindow(gui)
	local node = gui
	while node.Parent and node.Parent:IsA("GuiObject")
		and not node.Parent:IsA("LayerCollector") do
		node = node.Parent
	end
	return node
end

-- Woran man das Mailbox-Fenster erkennt, und was es garantiert nicht ist.
-- "gift" ist absichtlich raus: das traf FreeGifts.
local WINDOW_WORDS   = { "mailbox", "mail", "postbox", "post" }
local WINDOW_PENALTY = { "freegift", "giftbag", "balloon", "chat", "codes",
	"settings", "shop", "teleport", "map", "search" }

-- Ein Sendefenster hat einen Senden-Knopf. Das ist das zweite Merkmal
-- neben dem Namen - ohne eins von beiden wird ein Fenster nicht genommen.
local function hasSendButton(frame)
	for _, child in ipairs(frame:GetDescendants()) do
		if child:IsA("GuiButton") then
			if has(child.Name, "send") or has(child.Name, "senden") then
				return true
			end
			if child:IsA("TextButton")
				and (has(child.Text, "send") or has(child.Text, "senden")) then
				return true
			end
			for _, node in ipairs(child:GetChildren()) do
				if node:IsA("TextLabel")
					and (has(node.Text, "send") or has(node.Text, "senden")) then
					return true
				end
			end
		end
	end
	return false
end

local function allTextBoxes()
	local root = playerGui()
	if not root then
		return {}
	end
	local boxes = {}
	for _, child in ipairs(root:GetDescendants()) do
		if child:IsA("TextBox") then
			table.insert(boxes, child)
		end
	end
	return boxes
end

-- Weg 3: jedes Fenster mit Textfeld bewerten.
-- offen = +1000, Name passt = +500, Knoepfe = +1 pro Stueck, Nieten = -2000.
local function scanCandidates()
	local seen, list = {}, {}

	for _, box in ipairs(allTextBoxes()) do
		local frame = topWindow(box)
		local path = frame:GetFullName()

		if not seen[path] then
			seen[path] = true

			local buttons = 0
			for _, child in ipairs(frame:GetDescendants()) do
				if child:IsA("GuiButton") then
					buttons += 1
				end
			end

			local nameHit = false
			local node = box
			while node and node:IsA("GuiObject") and not nameHit do
				for _, word in ipairs(WINDOW_WORDS) do
					if has(node.Name, word) then
						nameHit = true
						break
					end
				end
				node = node.Parent
			end

			local penalty = false
			for _, word in ipairs(WINDOW_PENALTY) do
				if has(path, word) then
					penalty = true
					break
				end
			end

			local rendered = isRendered(box)
			local sendHit = hasSendButton(frame)

			local score = math.min(buttons, 150)
			if rendered then
				score += 1000
			end
			if nameHit then
				score += 500
			end
			if sendHit then
				score += 800
			end
			if penalty then
				score -= 2000
			end

			table.insert(list, {
				frame = frame,
				path = path,
				score = score,
				buttons = buttons,
				rendered = rendered,
				nameHit = nameHit,
				sendHit = sendHit,
				-- ohne Name-Treffer und ohne Senden-Knopf ist es nicht die Mailbox
				usable = (nameHit or sendHit) and not penalty,
			})
		end
	end

	table.sort(list, function(a, b)
		return a.score > b.score
	end)
	return list
end

Mailbox.candidates = scanCandidates

local function frameFromScan()
	local list = scanCandidates()
	if #list == 0 then
		return nil, "kein Fenster mit Textfeld in der PlayerGui"
	end
	for _, entry in ipairs(list) do
		if entry.usable then
			return entry.frame, nil
		end
	end
	return nil, "kein Fenster mit Senden-Knopf oder mail im Namen (bestes war "
		.. list[1].path .. ")"
end

local function findSendArea(frame)
	local direct = frame:FindFirstChild("SendFrame") or frame:FindFirstChild("Send")
	if direct then
		return direct
	end
	for _, child in ipairs(frame:GetDescendants()) do
		if child:IsA("GuiObject") and has(child.Name, "send") then
			return child
		end
	end
	-- letzter Versuch: irgendein Bereich mit einem Textfeld drin
	for _, child in ipairs(frame:GetDescendants()) do
		if child:IsA("TextBox") then
			return child.Parent and child.Parent.Parent or child.Parent
		end
	end
	return nil
end

function Mailbox.frames()
	local attempts = {
		{ name = "Config-Pfad",  fn = frameFromConfigPath },
		{ name = "Library",      fn = frameFromLibrary },
		{ name = "Fenster-Scan", fn = frameFromScan },
	}

	local problems = {}
	for _, attempt in ipairs(attempts) do
		local ok, frame, err = pcall(attempt.fn)
		if ok and frame then
			return frame, findSendArea(frame), nil, attempt.name
		end
		table.insert(problems, attempt.name .. " -> " .. tostring(ok and err or frame))
	end

	return nil, nil, table.concat(problems, " | "), nil
end

function Mailbox.isOpen()
	local frame = Mailbox.frames()
	if not frame then
		return false
	end
	local ok, visible = pcall(function()
		return frame.Visible
	end)
	return ok and visible == true
end

function Mailbox.inputs(sendFrame)
	local boxes = {}
	for _, child in ipairs(sendFrame:GetDescendants()) do
		if child:IsA("TextBox") then
			table.insert(boxes, child)
		end
	end

	local user, message
	for _, box in ipairs(boxes) do
		local path = box:GetFullName()
		if not user and (has(path, "username") or has(path, "user") or has(path, "player")) then
			user = box
		end
	end
	for _, box in ipairs(boxes) do
		if box ~= user and not message
			and (has(box:GetFullName(), "message") or has(box:GetFullName(), "note")) then
			message = box
		end
	end

	user = user or boxes[1]
	if not message then
		for _, box in ipairs(boxes) do
			if box ~= user then
				message = box
				break
			end
		end
	end

	return user, message, boxes
end

--== Pets lesen ================================================================

local PET_NAME_KEYS    = { "id", "Id", "ID", "name", "Name", "petId", "PetId" }
local PET_SHINY_KEYS   = { "sh", "shiny", "Shiny", "isShiny" }
local PET_VARIANT_KEYS = { "pt", "variant", "Variant", "vt", "type" }
local PET_AMOUNT_KEYS  = { "am", "amount", "Amount", "count", "Count", "qty" }
local PET_LOCK_KEYS    = { "lk", "l", "lock", "locked", "Locked", "lck", "lo",
	"favorite", "Favorite", "fav", "Fav", "f" }
local PET_EQUIP_KEYS   = { "eq", "equipped", "Equipped" }
local PET_UID_KEYS     = { "uid", "UID", "Uid", "guid", "unique" }

local function pick(entry, keys)
	for _, key in ipairs(keys) do
		local value = entry[key]
		if value ~= nil then
			return value, key
		end
	end
	return nil, nil
end

local function variantName(raw)
	if raw == nil or raw == 0 or raw == false then
		return "normal"
	end
	for name, id in pairs(MB.VariantIds or {}) do
		if raw == id or norm(raw) == norm(name) then
			return norm(name)
		end
	end
	return "unbekannt(" .. tostring(raw) .. ")"
end

function Mailbox.petInfo(entry, key)
	if type(entry) ~= "table" then
		return nil
	end
	local name = pick(entry, PET_NAME_KEYS)
	if name == nil then
		return nil
	end
	-- Schloss: festes Feld aus der Config hat Vorrang
	local lockedValue, lockedKey
	if MB.LockKey and MB.LockKey ~= "" then
		lockedValue, lockedKey = entry[MB.LockKey], MB.LockKey
	else
		lockedValue, lockedKey = pick(entry, PET_LOCK_KEYS)
	end

	return {
		name     = tostring(name),
		key      = norm(name),
		uid      = pick(entry, PET_UID_KEYS) or key,
		shiny    = pick(entry, PET_SHINY_KEYS) and true or false,
		variant  = variantName(pick(entry, PET_VARIANT_KEYS)),
		amount   = tonumber(pick(entry, PET_AMOUNT_KEYS)) or 1,
		locked   = (lockedValue ~= nil and lockedValue ~= false and lockedValue ~= 0),
		lockField = lockedKey,
		equipped = pick(entry, PET_EQUIP_KEYS) and true or false,
		raw      = entry,
	}
end

local PET_CONTAINER_PATHS = {
	{ "Inventory", "Pet" },      -- PS99: Singular, grosses P
	{ "Inventory", "pets" },
	{ "Inventory", "Pets" },
	{ "inventory", "pets" },
	{ "Pets" },
	{ "pets" },
}

function Mailbox.save()
	local client, libErr = requireClientLibrary()

	if client then
		local ok, data = pcall(function()
			if type(client.Save) == "table" and type(client.Save.Get) == "function" then
				return client.Save.Get()
			end
			if type(client.Save) == "function" then
				return client.Save()
			end
			return client.Data or client.save
		end)
		if ok and type(data) == "table" then
			return data
		end
		libErr = "Save.Get() -> " .. tostring(data)
	end

	-- Plan B: im Speicher suchen
	local data, memErr = saveFromMemory()
	if data then
		return data
	end

	return nil, "Spieldaten nicht lesbar. " .. tostring(libErr) .. " | Speicher: " .. tostring(memErr)
end

-- Wie sehr sieht diese Tabelle nach einer Pet-Liste aus? 0 bis 1
local function looksLikePetList(value)
	if type(value) ~= "table" then
		return 0
	end
	local entries, hits = 0, 0
	for _, item in pairs(value) do
		entries += 1
		if type(item) == "table" and pick(item, PET_NAME_KEYS) ~= nil then
			hits += 1
		end
		if entries >= 12 then
			break
		end
	end
	if entries == 0 then
		return 0
	end
	return hits / entries
end

-- Die Pet-Liste in den Spieldaten suchen, statt feste Pfade zu raten.
local function findPetContainer(data)
	local best, bestPath, bestScore = nil, nil, 0
	local visited = {}
	local queue = { { node = data, path = "save", depth = 0 } }
	local index = 1

	while index <= #queue do
		local current = queue[index]
		index += 1

		if type(current.node) == "table" and not visited[current.node] then
			visited[current.node] = true

			for key, value in pairs(current.node) do
				if type(value) == "table" then
					local childPath = current.path .. "." .. tostring(key)

					local count = 0
					for _ in pairs(value) do
						count += 1
					end

					local ratio = looksLikePetList(value)
					if ratio >= 0.5 and count > 0 then
						local score = ratio * 100 + math.min(count, 100)
						if has(tostring(key), "pet") then
							score += 150
						end
						if score > bestScore then
							best, bestPath, bestScore = value, childPath, score
						end
					end

					if current.depth < 3 then
						table.insert(queue, {
							node = value,
							path = childPath,
							depth = current.depth + 1,
						})
					end
				end
			end
		end
	end

	return best, bestPath
end

function Mailbox.petContainer()
	local data, err = Mailbox.save()
	if not data then
		return nil, err
	end

	-- 1. die bekannten Pfade
	for _, path in ipairs(PET_CONTAINER_PATHS) do
		local node = data
		local ok = true
		for _, step in ipairs(path) do
			if type(node) == "table" and node[step] ~= nil then
				node = node[step]
			else
				ok = false
				break
			end
		end
		if ok and type(node) == "table" and next(node) ~= nil then
			return node, nil, table.concat(path, ".")
		end
	end

	-- 2. selbst suchen
	local found, foundPath = findPetContainer(data)
	if found then
		Hub.log("pets: Liste gefunden unter " .. tostring(foundPath))
		return found, nil, foundPath
	end

	return nil, "Pet-Liste in den Spieldaten nicht gefunden "
		.. "('Debug: Spieldaten dumpen' zeigt den Aufbau)"
end

function Mailbox.pets()
	local container, err, path = Mailbox.petContainer()
	if not container then
		return nil, err
	end
	local pets = {}
	for key, entry in pairs(container) do
		local info = Mailbox.petInfo(entry, key)
		if info then
			table.insert(pets, info)
		end
	end
	table.sort(pets, function(a, b)
		return a.name < b.name
	end)
	return pets, nil, path
end

-- Liegt dieses Pet noch im Inventar?
-- true = ja, false = nein (also weg), nil = nicht pruefbar
function Mailbox.ownsUid(uid)
	uid = tostring(uid or "")
	if uid == "" then
		return nil
	end

	-- Cache leeren, damit wirklich frisch gelesen wird
	local container = Mailbox.petContainer()
	if type(container) ~= "table" then
		return nil
	end

	for key, entry in pairs(container) do
		if tostring(key) == uid then
			return true
		end
		if type(entry) == "table" then
			local entryUid = pick(entry, PET_UID_KEYS)
			if entryUid ~= nil and tostring(entryUid) == uid then
				return true
			end
		end
	end
	return false
end

