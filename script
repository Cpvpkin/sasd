--== "Druecke E" ===============================================================
-- ProximityPrompts sind das, was im Spiel als "Druecke E" erscheint.

-- Loest einen Prompt aus. Erst die Executor-Funktion, dann der Weg zu Fuss.
function Farm.firePrompt(prompt, amount)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false, "kein Prompt"
	end

	-- Reichweite kurz aufdrehen, damit der Server nicht wegen Distanz ablehnt
	local oldDistance = prompt.MaxActivationDistance
	pcall(function()
		if oldDistance < 40 then
			prompt.MaxActivationDistance = 40
		end
	end)

	local fired = false

	if type(fireproximityprompt) == "function" then
		local ok = pcall(fireproximityprompt, prompt, amount or 1)
		if not ok then
			-- manche Executoren wollen nur ein Argument
			ok = pcall(fireproximityprompt, prompt)
		end
		fired = ok
	end

	if not fired then
		-- zu Fuss: Taste druecken, halten, loslassen
		local ok = pcall(function()
			prompt:InputHoldBegin()
			local hold = prompt.HoldDuration or 0
			if hold > 0 then
				task.wait(hold + 0.15)
			else
				task.wait(0.1)
			end
			prompt:InputHoldEnd()
		end)
		fired = ok
	end

	if not fired then
		-- letzter Weg: echten Tastendruck schicken
		local ok = pcall(function()
			local vim = game:GetService("VirtualInputManager")
			local key = prompt.KeyboardKeyCode
			if key == Enum.KeyCode.Unknown then
				key = Enum.KeyCode.E
			end
			vim:SendKeyEvent(true, key, false, game)
			task.wait((prompt.HoldDuration or 0) + 0.2)
			vim:SendKeyEvent(false, key, false, game)
		end)
		fired = ok
	end

	pcall(function()
		prompt.MaxActivationDistance = oldDistance
	end)

	if not fired then
		return false, "Prompt liess sich nicht ausloesen"
	end
	return true
end

local function promptText(prompt)
	local parts = { prompt.Name }
	if prompt.ActionText ~= "" then
		table.insert(parts, prompt.ActionText)
	end
	if prompt.ObjectText ~= "" then
		table.insert(parts, prompt.ObjectText)
	end
	local parent = prompt.Parent
	if parent then
		table.insert(parts, parent.Name)
	end
	return table.concat(parts, " | ")
end

-- Alle ProximityPrompts in der Naehe, optional nach Text gefiltert
function Farm.nearbyPrompts(radius, words)
	radius = tonumber(radius) or 500

	local root = Util.root()
	local here = root and root.Position
	local found = {}

	for _, child in ipairs(workspace:GetDescendants()) do
		if child:IsA("ProximityPrompt") then
			local anchor = child.Parent
			local position = anchor and positionOf(anchor) or nil
			local distance = (position and here) and (position - here).Magnitude or math.huge

			if distance <= radius then
				local text = promptText(child)
				local hit = true
				if words and #words > 0 then
					hit = false
					for _, word in ipairs(words) do
						if has(text, word) then
							hit = true
							break
						end
					end
				end
				if hit then
					table.insert(found, {
						prompt = child,
						instance = anchor,
						name = (child.ObjectText ~= "" and child.ObjectText)
							or (anchor and anchor.Name) or child.Name,
						text = text,
						position = position,
						distance = distance,
						id = anchor and tonumber(anchor.Name) or nil,
					})
				end
			end
		end
	end

	table.sort(found, function(a, b)
		return a.distance < b.distance
	end)
	return found
end

-- Prompt an einem bestimmten Objekt finden. PS99 erzeugt die Prompts erst,
-- wenn man nah dran ist - darum wird hier vor Ort gesucht, nicht vorher.
function Farm.promptAt(instance, radius)
	radius = tonumber(radius) or 30

	-- 1. im Objekt selbst
	if instance then
		local inside = instance:FindFirstChildWhichIsA("ProximityPrompt", true)
		if inside then
			return inside, "im Objekt"
		end
		-- 2. beim Nachbarn im selben Modell
		local parent = instance.Parent
		if parent then
			local sibling = parent:FindFirstChildWhichIsA("ProximityPrompt", true)
			if sibling then
				return sibling, "im Elternteil"
			end
		end
	end

	-- 3. irgendein Prompt in Reichweite
	local near = Farm.nearbyPrompts(radius, nil)
	if #near > 0 then
		return near[1].prompt, string.format("%d Studs entfernt", math.floor(near[1].distance))
	end

	return nil, "keiner in " .. radius .. " Studs"
end

-- Am Ziel stehen und oeffnen. Drei Wege, in dieser Reihenfolge:
--   1. ProximityPrompt ausloesen
--   2. ClickDetector ausloesen
--   3. echten Tastendruck schicken - fuer Spiele mit eigener "Druecke E"-Anzeige
function Farm.pressAt(instance, label)
	local tries = tonumber(FC.Halloween.PressTries) or 6
	local radius = tonumber(FC.Halloween.PressRadius) or 30
	local keyName = FC.Halloween.Key or "E"
	local keySent = false

	for attempt = 1, tries do
		--== 1. echter Prompt
		local prompt, where = Farm.promptAt(instance, radius)
		if prompt then
			local ok, err = Farm.firePrompt(prompt)
			Hub.log("press: " .. tostring(label) .. " Prompt (" .. tostring(where)
				.. ", Versuch " .. attempt .. ") -> " .. (ok and "ok" or tostring(err)))
			if ok then
				return true, "Prompt"
			end
		end

		--== 2. ClickDetector
		if instance then
			local click = instance:FindFirstChildWhichIsA("ClickDetector", true)
				or (instance.Parent and instance.Parent:FindFirstChildWhichIsA("ClickDetector", true))
			if click and type(fireclickdetector) == "function" then
				local ok = pcall(fireclickdetector, click)
				Hub.log("press: " .. tostring(label) .. " ClickDetector -> "
					.. (ok and "ok" or "fehlgeschlagen"))
				if ok then
					return true, "ClickDetector"
				end
			end
		end

		--== 3. Taste wirklich druecken
		local okKey, how = Util.pressKey(keyName, 0.18)
		if okKey then
			keySent = true
			if attempt == 1 then
				Hub.log("press: " .. tostring(label) .. " kein Prompt gefunden ("
					.. tostring(where) .. "), schicke echtes '" .. keyName
					.. "' per " .. tostring(how))
			end
		elseif attempt == 1 then
			Hub.log("press: " .. tostring(label) .. " nichts zum Druecken und "
				.. tostring(how))
		end

		task.wait(0.25)
	end

	if keySent then
		-- Taste ist raus, ob das Spiel sie angenommen hat, sieht man nur im Spiel
		return true, "Taste " .. keyName .. " geschickt (ungeprueft)"
	end
	return false, "nichts zum Druecken gefunden"
end

-- Wie wird das naechste Objekt bedient? Prompt, Klick, Beruehrung, Taste?
function Farm.inspectNearest(radius)
	radius = tonumber(radius) or 40

	local root = Util.root()
	if not root then
		Hub.log("inspektion: kein Charakter")
		return
	end
	local here = root.Position

	local candidates = {}
	for _, child in ipairs(workspace:GetDescendants()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			local position = positionOf(child)
			if position then
				local distance = (position - here).Magnitude
				if distance <= radius then
					table.insert(candidates, { instance = child, distance = distance })
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.distance < b.distance
	end)

	Hub.log("--- Inspektion, " .. radius .. " Studs, " .. #candidates .. " Objekte ---")
	local shown = 0
	for _, entry in ipairs(candidates) do
		local node = entry.instance
		local prompt = node:FindFirstChildWhichIsA("ProximityPrompt", true)
		local click = node:FindFirstChildWhichIsA("ClickDetector", true)
		local touch = node:IsA("BasePart") and node.CanTouch or false

		-- nur Objekte zeigen, mit denen man etwas machen kann
		if prompt or click then
			shown += 1
			Hub.log(string.format("  %d weit  %s <%s>", math.floor(entry.distance),
				node.Name, node.ClassName))
			if prompt then
				Hub.log("      ProximityPrompt: Taste " .. tostring(prompt.KeyboardKeyCode)
					.. ", Text '" .. tostring(prompt.ActionText) .. "' / '"
					.. tostring(prompt.ObjectText) .. "', aktiv " .. tostring(prompt.Enabled)
					.. ", Reichweite " .. tostring(prompt.MaxActivationDistance))
			end
			if click then
				Hub.log("      ClickDetector: Reichweite " .. tostring(click.MaxActivationDistance))
			end
			if touch then
				Hub.log("      beruehrbar")
			end
			if shown >= 12 then
				break
			end
		end
	end

	if shown == 0 then
		Hub.log("  Kein Objekt mit Prompt oder ClickDetector in Reichweite.")
		Hub.log("  Dann zeichnet das Spiel sein 'Druecke E' selbst und fragt die")
		Hub.log("  Taste ab. Der Hub schickt deshalb einen echten Tastendruck.")
		Hub.log("  Welches Remote dabei feuert, zeigt 'ALLES mitlesen' + ein Haus per Hand.")
	end
	Hub.log("--- Ende Inspektion ---")
	nativeNotify("Big Hub", shown .. " bedienbare Objekte in der Naehe.", 7)
end

