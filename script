-- Sucht im Instanz-Ordner nach Objekten mit Zahlen-Namen - das sind die IDs,
-- die der Client an Instancing_InvokeCustomFromClient uebergibt.
function Farm.instanceTargets(instanceName)
	local targets = {}
	local things = workspace:FindFirstChild("__THINGS")
	if not things then
		return targets
	end

	local roots = {}
	for _, child in ipairs(things:GetChildren()) do
		if has(child.Name, "instance") or has(child.Name, "ground") then
			local sub = child:FindFirstChild(instanceName)
			if sub then
				table.insert(roots, sub)
			end
		end
	end
	local instances = things:FindFirstChild("Instances")
	if instances then
		local sub = instances:FindFirstChild(instanceName)
		if sub then
			table.insert(roots, sub)
		end
	end

	local root = Util.root()
	local here = root and root.Position

	for _, node in ipairs(roots) do
		for _, child in ipairs(node:GetDescendants()) do
			local id = tonumber(child.Name)
			if id then
				local position = positionOf(child)
				table.insert(targets, {
					id = id,
					distance = (position and here) and (position - here).Magnitude or math.huge,
				})
			end
		end
	end

	table.sort(targets, function(a, b)
		return a.distance < b.distance
	end)

	local ids = {}
	for _, entry in ipairs(targets) do
		table.insert(ids, entry.id)
	end
	return ids
end

--== Remote-Index ==============================================================
-- Remotes liegen in PS99 nicht nur in ReplicatedStorage.Network. Darum wird
-- einmal ein Index ueber alle plausiblen Orte gebaut und gemerkt.

Farm.remoteIndex = nil
Farm.remoteIndexCount = 0
Farm.remoteIndexTime = 0

local function isRemote(instance)
	return instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction")
		or instance:IsA("UnreliableRemoteEvent")
end

local function remoteRoots()
	local roots = { ReplicatedStorage }

	local things = workspace:FindFirstChild("__THINGS")
	if things then
		local remotes = things:FindFirstChild("__REMOTES")
		if remotes then
			table.insert(roots, remotes)
		end
	end
	local wsRemotes = workspace:FindFirstChild("__REMOTES")
	if wsRemotes then
		table.insert(roots, wsRemotes)
	end

	local okFirst, replicatedFirst = pcall(function()
		return game:GetService("ReplicatedFirst")
	end)
	if okFirst and replicatedFirst then
		table.insert(roots, replicatedFirst)
	end

	if LocalPlayer then
		table.insert(roots, LocalPlayer)
	end

	return roots
end

function Farm.buildRemoteIndex(force)
	if Farm.remoteIndex and not force then
		return Farm.remoteIndex
	end

	local index, count = {}, 0
	for _, root in ipairs(remoteRoots()) do
		local ok, descendants = pcall(function()
			return root:GetDescendants()
		end)
		if ok and type(descendants) == "table" then
			for _, child in ipairs(descendants) do
				if isRemote(child) and not index[child.Name] then
					index[child.Name] = child
					count += 1
				end
			end
		end
	end

	Farm.remoteIndex = index
	Farm.remoteIndexCount = count
	Farm.remoteIndexTime = os.clock()
	Hub.log("remotes: " .. count .. " im Index")
	return index
end

function Farm.remoteByName(name)
	if not name or name == "" then
		return nil
	end

	-- 1. was der Spion tatsaechlich im Einsatz gesehen hat, ist die Wahrheit
	local seen = Mailbox.seenRemotes and Mailbox.seenRemotes[name]
	if seen and seen.Parent then
		return seen
	end

	-- 2. schneller Weg
	local network = ReplicatedStorage:FindFirstChild("Network")
	if network then
		local direct = network:FindFirstChild(name)
		if direct then
			return direct
		end
	end

	-- 3. Index
	local index = Farm.buildRemoteIndex()
	local hit = index[name]
	if hit and hit.Parent then
		return hit
	end

	-- 4. Remote kann spaeter entstehen, aber nicht oefter als alle 10s suchen
	if os.clock() - Farm.remoteIndexTime > 10 then
		index = Farm.buildRemoteIndex(true)
		hit = index[name]
		if hit and hit.Parent then
			return hit
		end
	end

	return nil
end

-- Sagt fuer jedes benutzte Remote, wo es liegt oder dass es fehlt
function Farm.checkRemotes()
	Farm.buildRemoteIndex(true)

	local names = {
		{ "Orbs",             FC.Orbs.Remote },
		{ "Breakables",       FC.Breakables.DamageRemote },
		{ "Eggs an",          FC.Eggs.EnableRemote },
		{ "Eggs aus",         FC.Eggs.DisableRemote },
		{ "Halloween",        FC.Halloween.Remote },
		{ "Mailbox-Relay",    MB.RelayRemote },
	}

	Hub.log("--- Remote-Check (" .. Farm.remoteIndexCount .. " im Index) ---")
	local missing = 0
	for _, entry in ipairs(names) do
		local remote = Farm.remoteByName(entry[2])
		if remote then
			Hub.log("  OK     " .. entry[1] .. ": " .. remote:GetFullName()
				.. " <" .. remote.ClassName .. ">")
		else
			missing += 1
			Hub.log("  FEHLT  " .. entry[1] .. ": '" .. tostring(entry[2]) .. "'")
		end
	end
	Hub.log("--- " .. missing .. " von " .. #names .. " fehlen ---")

	if missing > 0 then
		Hub.log("Fehlende Remotes findet der Rekorder: Aktion einmal per Hand")
		Hub.log("machen, dann merkt sich der Hub die echte Instanz.")
