-- Overlay: eigene Anzeige auf dem Bildschirm
--------------------------------------------------------------------------------
-- Unabhaengig von Rayfield. Zeigt live, was gerade laeuft, damit man nicht
-- raten muss, ob der Hub etwas tut.

local Overlay = {}

Overlay.enabled = true
Overlay.rows = {}
Overlay.spinnerIndex = 1

local SPINNER = { "|", "/", "-", "\\" }

local ROW_ORDER = {
	{ key = "status",  label = "Status" },
	{ key = "loops",   label = "Aktiv" },
	{ key = "target",  label = "Ziel" },
	{ key = "actions", label = "Aktionen" },
	{ key = "last",    label = "Letztes" },
}

function Overlay.build()
	-- Manche Executoren verbieten Instance-Zugriff in bestimmten Threads
	-- ("lacking capability"). Nach so einem Fehler wird nicht mehr versucht,
	-- damit nie wieder eine aufrufende Funktion daran stirbt.
	if Overlay.broken then
		return nil
	end

	local okSelf, existing = pcall(function()
		return Overlay.gui and Overlay.gui.Parent and Overlay.gui or nil
	end)
	if okSelf and existing then
		return existing
	end

	local okParent, parent = pcall(function()
		if type(gethui) == "function" then
			local okHidden, hidden = pcall(gethui)
			if okHidden and hidden then
				return hidden
			end
		end
		return LocalPlayer:FindFirstChildOfClass("PlayerGui")
	end)

	if not okParent then
		Overlay.broken = true
		warn("[BigHub] Overlay aus: " .. tostring(parent))
		return nil
	end
	if not parent then
		return nil
	end

	local ok, gui = pcall(function()
		local screen = Instance.new("ScreenGui")
		screen.Name = "BigHubOverlay"
		screen.ResetOnSpawn = false
		screen.IgnoreGuiInset = true
		screen.DisplayOrder = 9999
		screen.Parent = parent

		local frame = Instance.new("Frame")
		frame.Name = "Panel"
		frame.AnchorPoint = Vector2.new(0, 0)
		frame.Position = UDim2.new(0, 12, 0, 90)
		frame.Size = UDim2.new(0, 330, 0, 0)
		frame.AutomaticSize = Enum.AutomaticSize.Y
		frame.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
		frame.BackgroundTransparency = 0.25
