-- Was steht hier eigentlich rum? Gruppiert Namen in der Umgebung nach Anzahl.
-- Damit finden wir heraus, wie die Haeuser im Event wirklich heissen.
function Farm.dumpNearby(radius, limit)
	radius = tonumber(radius) or 300
	limit = tonumber(limit) or 30

	local root = Util.root()
	if not root then
		Hub.log("umgebung: kein Charakter")
		return {}
	end
	local here = root.Position

	local groups = {}
	for _, child in ipairs(workspace:GetDescendants()) do
		if child:IsA("BasePart") or child:IsA("Model") then
			local position = positionOf(child)
			if position and (position - here).Magnitude <= radius then
				-- Zahlen-Namen zusammenfassen, sonst wird die Liste unlesbar
				local key = child.Name
				if tonumber(key) then
					key = "<Zahl>"
				end
				local entry = groups[key]
				if not entry then
					entry = { count = 0, nearest = math.huge, path = child:GetFullName() }
					groups[key] = entry
				end
				entry.count += 1
				local distance = (position - here).Magnitude
				if distance < entry.nearest then
					entry.nearest = distance
					entry.path = child:GetFullName()
				end
			end
		end
	end

	local list = {}
	for name, entry in pairs(groups) do
		table.insert(list, { name = name, entry = entry })
	end
	table.sort(list, function(a, b)
		return a.entry.count > b.entry.count
	end)

	Hub.log("--- Umgebung, " .. radius .. " Studs ---")
	for index, item in ipairs(list) do
		if index > limit then
			Hub.log("  ... " .. (#list - limit) .. " weitere Namen")
			break
		end
		Hub.log(string.format("  %3dx  %s   (naechstes %d weit)",
			item.entry.count, item.name, math.floor(item.entry.nearest)))
		if index <= 5 then
			Hub.log("          " .. item.entry.path)
		end
	end
	Hub.log("--- Ende Umgebung ---")
	nativeNotify("Big Hub", #list .. " verschiedene Namen in der Naehe.", 6)
	return list
end

-- Haeuser (oder was dem am naechsten kommt) in der Instanz, nach Entfernung
function Farm.halloweenHouses()
	local instanceName = Farm.halloweenInstance()

	-- Weg 1: ueber das "Druecke E". Das ist der direkte Weg.
	if FC.Halloween.UsePrompts then
		local prompts = Farm.nearbyPrompts(FC.Halloween.PromptRadius,
			FC.Halloween.PromptWords)

		-- nichts mit passendem Text? Dann alle Prompts nehmen.
		if #prompts == 0 then
			prompts = Farm.nearbyPrompts(FC.Halloween.PromptRadius, nil)
			if #prompts > 0 then
				Hub.log("halloween: kein Prompt mit passendem Text, nehme alle "
					.. #prompts .. " in der Naehe")
			end
		end

		if #prompts > 0 then
			return prompts, instanceName
		end
	end

	local folder = Farm.instanceFolder(instanceName)
	local roots = {}

	if folder then
		table.insert(roots, folder)
	else
		-- keine Instanz gefunden: in der ganzen Workspace nach Haeusern suchen
		local things = workspace:FindFirstChild("__THINGS")
		if things then
			table.insert(roots, things)
		end
	end

	local root = Util.root()
	local here = root and root.Position
	local found = {}

	local exact = {}
	for _, name in ipairs(FC.Halloween.HouseNames or {}) do
		exact[norm(name)] = true
	end
	local useExact = next(exact) ~= nil

	for _, node in ipairs(roots) do
		for _, child in ipairs(node:GetDescendants()) do
			local hit
			if useExact then
				hit = exact[norm(child.Name)] == true
			else
				hit = matchesAny(child.Name, FC.Halloween.HouseWords)
					and not matchesAny(child.Name, FC.Halloween.BossWords)
			end
			if hit then
				local position = positionOf(child)
				if position then
					table.insert(found, {
						instance = child,
						name = child.Name,
						id = tonumber(child.Name),
						position = position,
						distance = here and (position - here).Magnitude or math.huge,
					})
				end
			end
		end
	end

	-- Doppelte Positionen aussortieren (Modell + Teile im Modell)
	local unique, seen = {}, {}
	for _, entry in ipairs(found) do
		local key = string.format("%d_%d_%d",
			math.floor(entry.position.X / 8),
			math.floor(entry.position.Y / 8),
			math.floor(entry.position.Z / 8))
		if not seen[key] then
			seen[key] = true
			table.insert(unique, entry)
		end
	end

	table.sort(unique, function(a, b)
		return a.distance < b.distance
	end)
	return unique, instanceName
end

-- Das Egg, an dem er AFK stehen soll
local EGG_FOLDERS = { "CustomEggs", "Eggs", "ZoneEggs", "InfinityEggs", "RenderedEggs" }

function Farm.findEgg(wanted)
	wanted = trim(wanted)
	if wanted == "" then
		wanted = trim(CONFIG.Farm.Eggs.EggName)
	end

	local things = workspace:FindFirstChild("__THINGS")
	if not things then
		return nil, "__THINGS fehlt"
	end

	local root = Util.root()
	local here = root and root.Position
	local best, bestScore, bestDistance

	for _, folderName in ipairs(EGG_FOLDERS) do
		local folder = things:FindFirstChild(folderName)
		if folder then
			for _, child in ipairs(folder:GetChildren()) do
				local position = positionOf(child)
				if position then
					local distance = here and (position - here).Magnitude or math.huge
					-- Namenstreffer schlaegt Entfernung
					local score = 0
					if wanted ~= "" and has(child.Name, wanted) then
						score = 100
					elseif wanted ~= "" and has(wanted, child.Name) then
						score = 80
					end
					if not bestScore or score > bestScore
						or (score == bestScore and distance < bestDistance) then
						best, bestScore, bestDistance = child, score, distance
					end
				end
			end
		end
	end

	if not best then
		return nil, "kein Egg in der Workspace gefunden"
	end
	return best, nil, bestScore
end

-- Die 32-stellige UID eines Eggs finden. Im Rekorder-Log sah der Aufruf so aus:
--   CustomEggs_Hatch:InvokeServer("e30dd47c93cf4231aabc2329a5dc1fb1", 28)
local HEX32 = "^%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x$"

function Farm.eggUid(model)
	if not model then
		return nil, "kein Egg"
	end

	if tostring(model.Name):match(HEX32) then
		return model.Name, "Modellname"
	end

	local okAttrs, attrs = pcall(function()
		return model:GetAttributes()
	end)
	if okAttrs and type(attrs) == "table" then
		for key, value in pairs(attrs) do
			if type(value) == "string" and value:match(HEX32) then
				return value, "Attribut " .. tostring(key)
			end
		end
	end

	for _, child in ipairs(model:GetDescendants()) do
		if tostring(child.Name):match(HEX32) then
			return child.Name, "Kind <" .. child.ClassName .. ">"
		end
		if child:IsA("StringValue") and tostring(child.Value):match(HEX32) then
			return child.Value, "StringValue " .. child.Name
		end
	end

	return nil, "keine 32-stellige UID am Egg gefunden"
end

