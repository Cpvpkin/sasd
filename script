-- damit nicht der ganze Hub steht, wenn sirius.menu mal weg ist.
local RAYFIELD_CACHE = "BigHub_rayfield.lua"

local function runRayfield(body, quelle, problems)
	local chunk, compileError = loadstring(body)
	if not chunk then
		table.insert(problems, quelle .. ": Kompilierfehler " .. tostring(compileError))
		return nil
	end
	local okRun, result = pcall(chunk)
	if okRun and type(result) == "table" then
		print("[BigHub] UI-Bibliothek geladen (" .. quelle .. ")")
		return result
	end
	table.insert(problems, quelle .. ": Laufzeitfehler " .. tostring(result))
	return nil
end

local function loadRayfield()
	local problems = {}

	-- 1. aus dem Netz
	for versuch = 1, 3 do
		local okGet, body = pcall(function()
			return game:HttpGet("https://sirius.menu/gen2")
		end)
		if okGet and type(body) == "string" and #body > 2000 then
			local result = runRayfield(body, "Netz, Versuch " .. versuch, problems)
			if result then
				pcall(function()
					if writefile then
						writefile(RAYFIELD_CACHE, body)
					end
				end)
				return result
			end
		else
			table.insert(problems, "Versuch " .. versuch .. ": HttpGet "
				.. tostring(body):sub(1, 120))
		end
		task.wait(1)
	end

	-- 2. aus der lokalen Kopie
	local okFile, body = pcall(function()
		if isfile and isfile(RAYFIELD_CACHE) and readfile then
			return readfile(RAYFIELD_CACHE)
		end
		return nil
	end)
	if okFile and type(body) == "string" and #body > 2000 then
		print("[BigHub] Netz ging nicht, nehme die lokale Kopie")
		local result = runRayfield(body, "lokale Kopie", problems)
		if result then
			return result
		end
	else
		table.insert(problems, "keine lokale Kopie vorhanden")
	end

	return nil, table.concat(problems, " | ")
end

local Rayfield, rayfieldError = loadRayfield()

