end

function Mailbox.lockRemotes()
	local list = {}
	local seen = {}

	-- Diese Woerter deuten auf ein Lock an. "favorite" ist dabei, weil
	-- manche Spiele das Schloss so nennen.
	local goodWords = { "lock", "favorite", "favourite", "fav" }
	-- Diese Remotes werden NIE angefasst, auch wenn der Name passt.
	local badWords = { "delete", "remove", "sell", "destroy", "trash", "discard",
		"craft", "fuse", "upgrade", "enchant", "buy", "purchase", "claim" }

	local function consider(remote)
		if not remote or seen[remote] then
			return
		end
		local name = norm(remote.Name)

		local good = false
		for _, word in ipairs(goodWords) do
			if name:find(word, 1, true) then
				good = true
				break
			end
		end
		if not good then
			return
		end

		for _, word in ipairs(badWords) do
			if name:find(word, 1, true) then
				return
			end
		end

		seen[remote] = true
		-- Pet-Remotes zuerst, dann der Rest
		local score = 0
		if name:find("lock", 1, true) then
			score += 20
		end
		if name:find("pet", 1, true) then
			score += 10
		end
		if name:find("inventory", 1, true) or name:find("item", 1, true) then
			score += 5
		end
		table.insert(list, { remote = remote, score = score })
	end

	if MB.UnlockRemote and trim(MB.UnlockRemote) ~= "" then
		local direct = Farm.remoteByName(MB.UnlockRemote)
		if direct then
			return { { remote = direct, score = 99 } }
		end
	end

	local network = ReplicatedStorage:FindFirstChild("Network")
	if network then
		for _, child in ipairs(network:GetChildren()) do
			consider(child)
		end
	end
	for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
		if child:IsA("RemoteEvent") or child:IsA("RemoteFunction")
			or child:IsA("UnreliableRemoteEvent") then
			consider(child)
		end
	end
	for name, remote in pairs(Mailbox.seenRemotes or {}) do
		if remote and remote.Parent then
			consider(remote)
		end
	end

	table.sort(list, function(a, b)
		return a.score > b.score
	end)
	return list
end

-- Argumentformen, die ein Lock-Remote ueblicherweise erwartet
local function unlockAttempts(uid)
	return {
		{ label = "(uid, false)", args = { uid, false } },
		{ label = "(uid)",        args = { uid } },
		{ label = "({uid}, false)", args = { { uid }, false } },
		{ label = "({uid})",      args = { { uid } } },
		{ label = "(uid, 0)",     args = { uid, 0 } },
	}
end

local function fireUnlock(remote, args)
	return pcall(function()
		if remote:IsA("RemoteFunction") then
			return remote:InvokeServer(table.unpack(args))
		end
		return remote:FireServer(table.unpack(args))
	end)
end

