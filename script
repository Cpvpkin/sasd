-- Das Lock-Remote kennen wir nicht, also: Kandidaten suchen, Argumentformen
-- durchprobieren und nach jedem Versuch im Save nachsehen, ob es geklappt hat.
-- Die Kombination, die funktioniert, wird gemerkt und danach direkt benutzt.

Mailbox.unlockRecipe = nil

function Mailbox.petByUid(uid)
	uid = tostring(uid or "")
	local pets = Mailbox.pets()
	if not pets then
		return nil
	end
	for _, info in ipairs(pets) do
