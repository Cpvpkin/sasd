	if not box:IsA("TextBox") then
		box = box:FindFirstChildWhichIsA("TextBox", true)
		if not box then
			return false, "keine TextBox"
		end
	end

	value = tostring(value or "")

	pcall(function()
		box:CaptureFocus()
	end)
	box.Text = value
	task.wait(0.05)
	box.Text = value
	pcall(function()
		box:ReleaseFocus(true)   -- true = wie Enter druecken
	end)
	task.wait(0.05)

	return box.Text == value, box.Text
end

