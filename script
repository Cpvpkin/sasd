		local chosen, err, total = Mailbox.collect()
		if not chosen then
			Hub.status("Vorschau fehlgeschlagen: " .. tostring(err))
			nativeNotify("Big Hub", tostring(err), 8)
			return
		end
		Hub.log("--- Vorschau: " .. #chosen .. " von " .. tostring(total) .. " ---")
		for _, info in ipairs(chosen) do
			Hub.log("  + " .. info.name .. " [" .. info.variant
