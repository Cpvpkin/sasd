function Farm.dumpThings()
	local things = workspace:FindFirstChild("__THINGS")
	if not things then
		Hub.log("__THINGS nicht in der Workspace")
		-- dann wenigstens die oberste Ebene
		for _, child in ipairs(workspace:GetChildren()) do
			Hub.log("  " .. child.Name .. " <" .. child.ClassName .. ">  kinder="
				.. #child:GetChildren())
		end
		return
	end

	Hub.log("--- Workspace.__THINGS ---")
	local children = things:GetChildren()
	Hub.log(#children .. " Ordner")
	for _, child in ipairs(children) do
		local count = #child:GetChildren()
		local first = child:GetChildren()[1]
		Hub.log("  " .. child.Name .. " <" .. child.ClassName .. ">  kinder=" .. count
			.. (first and ("  erstes: " .. first.Name .. " <" .. first.ClassName .. ">") or ""))
	end
	Hub.log("--- Ende __THINGS ---")
	nativeNotify("Big Hub", #children .. " Ordner in __THINGS, siehe Konsole.", 6)
end

function Farm.dumpWorkspace()
	Hub.log("--- Workspace, zwei Ebenen ---")
	local printed = 0
	for _, child in ipairs(workspace:GetChildren()) do
		local count = #child:GetChildren()
		Hub.log("  " .. child.Name .. " <" .. child.ClassName .. ">  kinder=" .. count)
		printed += 1
		if count > 0 and count < 400 then
			local shown = 0
			for _, sub in ipairs(child:GetChildren()) do
				shown += 1
				if shown > 6 then
					Hub.log("      ... " .. (count - 6) .. " weitere")
					break
				end
				Hub.log("      " .. sub.Name .. " <" .. sub.ClassName .. ">  kinder="
					.. #sub:GetChildren())
				printed += 1
			end
		end
		if printed > 160 then
			Hub.log("  ... abgeschnitten")
			break
		end
	end
	Hub.log("--- Ende Workspace ---")
	nativeNotify("Big Hub", "Workspace in der Konsole.", 5)
end

