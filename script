--== Spion ====================================================================
-- Liest mit, was das Spiel selbst an "Mailbox: Send" schickt. Damit sehen wir
-- die genaue Form der Argumente, ohne zu raten.

Mailbox.spyActive = false
Mailbox.spyInstalled = false
Mailbox.spyAllUntil = nil
-- Name -> echte Remote-Instanz, wie der Spion sie gesehen hat
Mailbox.seenRemotes = {}
-- Instanzname -> { action, lastId, count, actions }
Mailbox.learnedInstancing = {}

-- Remotes, die im Sekundentakt feuern und das Log zumuellen wuerden
local SPY_NOISE = {
	"position", "replicate", "ping", "heartbeat", "render", "camera",
	"character", "animation", "chat", "stats", "tick",
}

function Mailbox.spy(enable, quiet)
	if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
		Hub.log("spion: Executor hat kein hookmetamethod/getnamecallmethod")
		if not quiet then
			nativeNotify("Big Hub", "Dein Executor kann nicht mitlesen.", 7)
		end
		return false
	end

	Mailbox.spyActive = enable ~= false

	if Mailbox.spyInstalled then
		Hub.log("spion: " .. (Mailbox.spyActive and "an" or "aus"))
		if not quiet then
			nativeNotify("Big Hub", "Spion " .. (Mailbox.spyActive and "an" or "aus") .. ".", 4)
		end
		return true
	end

	local busy = false
	local original
	original = hookmetamethod(game, "__namecall", function(self, ...)
		local learning = Mailbox.learnUntil and os.clock() < Mailbox.learnUntil
		if (Mailbox.spyActive or Mailbox.spyAllUntil or Mailbox.recordUntil or learning)
			and not busy then
			local okMethod, method = pcall(getnamecallmethod)
			if okMethod and (method == "InvokeServer" or method == "FireServer") then
				local okName, name = pcall(function()
					return self.Name
				end)
				if okName and type(name) == "string" then
					-- Jede gesehene Remote-Instanz merken. Das ist die einzige
					-- Quelle, die garantiert stimmt, egal wo das Remote haengt.
					Mailbox.seenRemotes[name] = self

					-- Instancing-Aufrufe lernen: Instanz, Aktion, letzte ID.
					-- Damit konfiguriert sich der Halloween-Loop selbst.
					if has(name, "instancing") then
						local instanceName, action, id = ...
						if type(instanceName) == "string" and type(action) == "string" then
							local entry = Mailbox.learnedInstancing[instanceName]
							if not entry then
								entry = { count = 0, actions = {} }
								Mailbox.learnedInstancing[instanceName] = entry
							end
							entry.count += 1
							entry.action = action
							entry.lastId = id
							entry.actions[action] = (entry.actions[action] or 0) + 1
						end
					end

					-- Rekorder: gruppiert mitschreiben statt jede Zeile zu loggen
					if Mailbox.recordUntil then
						if os.clock() < Mailbox.recordUntil then
							local noisy = false
							for _, noise in ipairs(SPY_NOISE) do
								if has(name, noise) then
									noisy = true
									break
								end
							end
							-- Fokus-Modus: nur ein Remote, dafuer jeden Aufruf
							if Mailbox.focusPattern then
								noisy = not has(name, Mailbox.focusPattern)
							end

							if not noisy then
								local entry = Mailbox.recorded[name]
								if not entry then
									entry = {
										count = 0,
										method = method,
										n = select("#", ...),
										args = { ... },
										samples = {},
									}
									Mailbox.recorded[name] = entry
								end
								entry.count += 1

								if Mailbox.focusPattern and #entry.samples < 12 then
									table.insert(entry.samples, { n = select("#", ...), args = { ... } })
								end
							end
						else
							Mailbox.recordUntil = nil
						end
					end

					local interesting = Mailbox.spyActive and has(name, "mailbox")

					-- Alles-mitlesen-Modus, laeuft auf Zeit
					if not interesting and Mailbox.spyAllUntil then
						if os.clock() < Mailbox.spyAllUntil then
							interesting = true
							for _, noise in ipairs(SPY_NOISE) do
								if has(name, noise) then
									interesting = false
									break
								end
							end
						else
							Mailbox.spyAllUntil = nil
						end
					end

					if interesting then
						busy = true
						local count = select("#", ...)
						local args = { ... }

						-- Relay merken, falls der Name im Spiel wechselt
						if name == MB.RelayRemote then
							Mailbox.relayInstance = self
						end

						pcall(function()
							local path = name
							local okPath, full = pcall(function()
								return self:GetFullName()
							end)
							if okPath then
								path = full
							end
							Hub.log("### SPION: " .. path .. ":" .. tostring(method)
								.. "  " .. count .. " Argument(e)")
							for index = 1, count do
								Hub.log("  Argument " .. index .. ":")
								dumpValue(args[index], "    ", 0)
							end
							Hub.log("### Ende Spion")
						end)
						if has(name, "mailbox") then
							Mailbox.lastSpyArgs = args
						end
						busy = false
					end
				end
			end
		end
		return original(self, ...)
	end)

	Mailbox.spyInstalled = true
	if quiet then
		Hub.log("spion: still installiert (lernt Remote-Instanzen)")
	else
		Hub.log("spion: installiert und an")
		Hub.log("Jetzt EIN Pet per Hand ueber die Spiel-Mailbox verschicken.")
		nativeNotify("Big Hub", "Spion an. Jetzt EIN Pet per Hand verschicken.", 9)
	end
	return true
end

--== Rekorder =================================================================
-- Schreibt X Sekunden lang mit, WELCHE Remotes feuern und wie oft, mit je
-- einem Beispiel-Argumentsatz. Eine Sitzung reicht fuer mehrere Features.

Mailbox.recorded = {}
Mailbox.recordUntil = nil
Mailbox.focusPattern = nil

-- Nur ein Remote, dafuer jeden einzelnen Aufruf mit allen Argumenten
function Mailbox.recordFocus(pattern, seconds)
	Mailbox.focusPattern = norm(pattern)
	Hub.log("rekorder: Fokus auf Remotes mit '" .. tostring(pattern) .. "' im Namen")
	Mailbox.record(seconds or 45)
end

function Mailbox.record(seconds)
	seconds = tonumber(seconds) or 60

	-- Zweiter Klick waehrend einer Aufnahme verlaengert nur, statt alles
	-- Mitgeschriebene wegzuwerfen.
	if Mailbox.recordUntil and os.clock() < Mailbox.recordUntil then
		Mailbox.recordUntil = os.clock() + seconds
		Hub.log("rekorder: laeuft schon, um " .. seconds .. "s verlaengert")
		nativeNotify("Big Hub", "Rekorder verlaengert.", 5)
		return
	end

	if not Mailbox.spyInstalled then
		if not Mailbox.spy(false) then
			return
		end
		Mailbox.spyActive = false
	end

	Mailbox.recorded = {}
	Mailbox.recordUntil = os.clock() + seconds

	Hub.log("=== Rekorder laeuft " .. seconds .. "s ===")
	Hub.log("Mach jetzt im Spiel die Aktionen, die der Hub lernen soll:")
	Hub.log("  Egg oeffnen, Halloween-Runde, saeen/waessern/ernten, Orb einsammeln")
	nativeNotify("Big Hub", "Rekorder laeuft " .. seconds .. "s. Jetzt spielen!", 10)

	task.delay(seconds, function()
		-- wurde zwischendurch verlaengert? Dann uebernimmt der spaetere Lauf.
		if Mailbox.recordUntil and os.clock() < Mailbox.recordUntil - 0.5 then
			return
		end
		Mailbox.recordUntil = nil

		local list = {}
		for name, entry in pairs(Mailbox.recorded) do
			table.insert(list, { name = name, entry = entry })
		end
		table.sort(list, function(a, b)
			return a.entry.count > b.entry.count
		end)

		Hub.log("=== Rekorder fertig: " .. #list .. " verschiedene Remotes ===")
		for index, item in ipairs(list) do
			if index > 25 then
				Hub.log("... " .. (#list - 25) .. " weitere")
				break
			end
			Hub.log(index .. ". " .. item.name .. "  (" .. item.entry.method
				.. ", " .. item.entry.count .. "x, " .. item.entry.n .. " Argumente)")

			local samples = item.entry.samples or {}
			if #samples > 0 then
				-- Fokus-Modus: jeder mitgeschriebene Aufruf einzeln
				for sampleIndex, sample in ipairs(samples) do
					Hub.log("   Aufruf " .. sampleIndex .. ":")
					for argIndex = 1, sample.n do
						dumpValue(sample.args[argIndex], "       ", 2)
					end
				end
			else
				for argIndex = 1, item.entry.n do
					Hub.log("     Argument " .. argIndex .. ":")
					dumpValue(item.entry.args[argIndex], "       ", 1)
				end
			end
		end
		Hub.log("=== Ende Rekorder ===")
		Mailbox.focusPattern = nil
		nativeNotify("Big Hub", "Rekorder fertig: " .. #list .. " Remotes. Konsole kopieren.", 8)
	end)
end

-- Liest fuer X Sekunden JEDEN Remote-Aufruf mit, nicht nur Mailbox.
-- Fuer den Fall, dass das Senden ueber ein anders benanntes Remote laeuft.
function Mailbox.spyEverything(seconds)
	seconds = tonumber(seconds) or 25

	if not Mailbox.spyInstalled then
		if not Mailbox.spy(false) then
			return
		end
		Mailbox.spyActive = false
	end

	Mailbox.spyAllUntil = os.clock() + seconds
	Hub.log("--- Alles-Mitleser an, " .. seconds .. "s ---")
	Hub.log("JETZT die Mailbox oeffnen und ein Pet verschicken.")
	nativeNotify("Big Hub", "Mitleser an (" .. seconds .. "s). Jetzt senden!", 9)

	task.delay(seconds, function()
		Mailbox.spyAllUntil = nil
		Hub.log("--- Alles-Mitleser aus ---")
		nativeNotify("Big Hub", "Mitleser aus. Konsole kopieren.", 6)
	end)
end

--[[ ==========================================================================

	  W E B H O O K

	  Erkennt geschluepfte Pets daran, dass neue UIDs im Inventar auftauchen.
	  Das funktioniert unabhaengig davon, wie gehatcht wurde.

   ========================================================================== ]]

local Web = {}

local WH = CONFIG.Farm.Webhook
local HttpService = game:GetService("HttpService")

Web.queue = {}
Web.lastFlush = 0
Web.firstSent = false
Web.totalSeen = 0

-- Executoren nennen die Funktion unterschiedlich
local function resolveRequest()
	if type(http_request) == "function" then
		return http_request
	end
	if syn and type(syn.request) == "function" then
		return syn.request
	end
	if http and type(http.request) == "function" then
		return http.request
	end
	if fluxus and type(fluxus.request) == "function" then
		return fluxus.request
	end
	if type(request) == "function" then
		return request
	end
	return nil
end

function Web.ready()
	return resolveRequest() ~= nil and trim(WH.Url) ~= ""
end

-- URL nie vollstaendig loggen: Konsolen-Logs werden weitergegeben
function Web.masked()
	local url = trim(WH.Url)
	if url == "" then
		return "(leer)"
	end
	local tail = url:sub(-4)
	return "...." .. tail .. " (" .. #url .. " Zeichen)"
end

function Web.post(payload)
	local fn = resolveRequest()
	if not fn then
		return false, "Executor hat keine request-Funktion"
	end
	local url = trim(WH.Url)
	if url == "" then
		return false, "keine Webhook-URL gesetzt"
	end

	local okJson, body = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if not okJson then
		return false, "JSON fehlgeschlagen: " .. tostring(body)
	end

	local ok, response = pcall(fn, {
		Url = url,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = body,
	})
	if not ok then
		return false, tostring(response)
	end

	local code = 0
	if type(response) == "table" then
		code = tonumber(response.StatusCode) or tonumber(response.Status) or 0
	end
	if code >= 200 and code < 300 then
		return true, code
	end
	return false, "HTTP " .. tostring(code)
end

local function petLine(info)
	local extra = {}
	if info.variant and info.variant ~= "normal" then
		table.insert(extra, info.variant)
	end
	if info.shiny then
		table.insert(extra, "shiny")
	end
	if #extra > 0 then
		return info.name .. " [" .. table.concat(extra, ", ") .. "]"
	end
	return info.name
end

function Web.isRare(info)
	for _, word in ipairs(WH.Words or {}) do
		if has(info.name, word) then
			return true
		end
	end
	return false
end

function Web.sendPet(info, reason)
	local rare = Web.isRare(info)
	local payload = {
		username = WH.Name or "Big Hub",
		content = (rare and trim(WH.Ping) ~= "") and WH.Ping or nil,
		embeds = { {
			title = petLine(info),
			description = rare and "**Seltenes Pet geschluepft!**" or "Pet geschluepft",
			color = rare and 16755200 or 9126655,
			fields = {
				{ name = "Variante", value = tostring(info.variant), inline = true },
				{ name = "Shiny", value = info.shiny and "ja" or "nein", inline = true },
				{ name = "Egg", value = tostring(CONFIG.Farm.Eggs.EggName), inline = true },
			},
			footer = { text = "Big Hub  |  " .. tostring(LocalPlayer.Name)
				.. (reason and ("  |  " .. reason) or "") },
		} },
	}

	local ok, err = Web.post(payload)
	if ok then
		Hub.log("webhook: '" .. petLine(info) .. "' gemeldet")
	else
		Hub.log("webhook: senden fehlgeschlagen - " .. tostring(err))
	end
	return ok
end

function Web.flush(force)
	if #Web.queue == 0 then
		return
	end
	local now = os.clock()
	if not force and (now - Web.lastFlush) < (tonumber(WH.Batch) or 10) then
		return
	end
	Web.lastFlush = now

	-- gleiche Pets zusammenfassen
	local counts, order = {}, {}
	for _, info in ipairs(Web.queue) do
		local key = petLine(info)
		if not counts[key] then
			counts[key] = 0
			table.insert(order, key)
		end
		counts[key] += 1
	end
	Web.queue = {}

	local lines = {}
	for _, key in ipairs(order) do
		table.insert(lines, counts[key] .. "x  " .. key)
	end

	local text = table.concat(lines, "\n")
	if #text > 1800 then
		text = text:sub(1, 1800) .. "\n..."
	end

	local ok, err = Web.post({
		username = WH.Name or "Big Hub",
		embeds = { {
			title = #order .. " verschiedene Pets",
			description = text,
			color = 9126655,
			footer = { text = "Big Hub  |  " .. tostring(LocalPlayer.Name)
				.. "  |  insgesamt " .. Web.totalSeen },
		} },
	})
	if not ok then
		Hub.log("webhook: Sammelmeldung fehlgeschlagen - " .. tostring(err))
	end
end

-- Neue Pets verarbeiten, nach Einstellung melden
function Web.report(list)
	local mode = norm(WH.Mode)
	if mode == "off" then
		return
	end

	for _, info in ipairs(list) do
		Web.totalSeen += 1

		local first = WH.SendFirst and not Web.firstSent
		if first then
			Web.firstSent = true
			Web.sendPet(info, "erstes Pet dieser Sitzung")
		elseif Web.isRare(info) then
			Web.sendPet(info)
		elseif mode == "all" then
			table.insert(Web.queue, info)
		end
	end

	Web.flush(false)
end

function Web.sendStart(eggName, amount)
	if not WH.SendStart or not Web.ready() then
