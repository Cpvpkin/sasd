-- Blind entsperren: feuert das Unlock-Remote, ohne auf den Schloss-Status
-- zu schauen. Fuer den Fall, dass der Hub das Schloss nicht erkennt.
function Mailbox.unlockAlways(info)
	local uid = tostring(info.uid or "")
	if uid == "" then
		return false, "keine UID"
	end

	local mode = norm(MB.UnlockMode)

	-- Der Weg, der per Hand funktioniert: Rechtsklick + Freischalten
	if mode == "gui" then
		return Mailbox.unlockViaGui(info)
	end

	local remote = Farm.remoteByName(MB.UnlockRemote)
	if not remote then
		if mode == "both" then
			return Mailbox.unlockViaGui(info)
		end
		return false, "Remote '" .. tostring(MB.UnlockRemote) .. "' nicht gefunden"
	end

	-- beide ueblichen Formen, einmal einzeln und einmal als Liste
	local sent = 0
	for _, args in ipairs({ { uid }, { { uid } } }) do
		local ok = pcall(function()
			if remote:IsA("RemoteFunction") then
				return remote:InvokeServer(table.unpack(args))
			end
			return remote:FireServer(table.unpack(args))
		end)
		if ok then
			sent += 1
		end
		task.wait(0.08)
	end

	if sent == 0 then
		if mode == "both" then
			return Mailbox.unlockViaGui(info)
		end
		return false, "Aufruf fehlgeschlagen"
	end

	-- Bei "both" zusaetzlich den GUI-Weg gehen, wenn das Schloss erkennbar
	-- noch dran ist. Doppelt entsperren schadet nicht.
	if mode == "both" and Mailbox.isLocked(uid) == true then
		local okGui, howGui = Mailbox.unlockViaGui(info)
		if okGui then
			return true, remote.Name .. " + " .. tostring(howGui)
		end
	end

	return true, remote.Name .. " (" .. sent .. " Formen)"
end

-- true = Pet ist jetzt offen
function Mailbox.unlock(info)
	local uid = tostring(info.uid or "")
	if uid == "" then
		return false, "keine UID"
	end
	if Mailbox.isLocked(uid) == false then
		return true, "war schon offen"
	end

	-- bekannte Kombination zuerst
	if Mailbox.unlockRecipe then
		local recipe = Mailbox.unlockRecipe
		if recipe.remote and recipe.remote.Parent then
			local args = {}
			for _, value in ipairs(recipe.template) do
				if value == "__UID__" then
					table.insert(args, uid)
				elseif value == "__UIDLIST__" then
					table.insert(args, { uid })
				else
					table.insert(args, value)
				end
			end
			fireUnlock(recipe.remote, args)
			task.wait(0.35)
			if Mailbox.isLocked(uid) == false then
				return true, recipe.label
			end
		end
	end

	-- sonst durchprobieren und am Save pruefen
	local candidates = Mailbox.lockRemotes()
	if #candidates == 0 then
		return false, "kein Remote mit 'lock' im Namen gefunden"
	end

	for _, candidate in ipairs(candidates) do
		for _, attempt in ipairs(unlockAttempts(uid)) do
			local ok = fireUnlock(candidate.remote, attempt.args)
			if ok then
				task.wait(0.35)
				if Mailbox.isLocked(uid) == false then
					-- Rezept merken, damit der Rest schnell geht
					local template = {}
					for _, value in ipairs(attempt.args) do
						if value == uid then
							table.insert(template, "__UID__")
						elseif type(value) == "table" then
							table.insert(template, "__UIDLIST__")
						else
							table.insert(template, value)
						end
					end
					Mailbox.unlockRecipe = {
						remote = candidate.remote,
						template = template,
						label = candidate.remote.Name .. " " .. attempt.label,
					}
					Hub.log("unlock: funktioniert mit " .. Mailbox.unlockRecipe.label)
					return true, Mailbox.unlockRecipe.label
				end
			end
		end
	end

	return false, "keine Kombination hat das Schloss geoeffnet"
end

-- Zeigt, welche Felder deine Pets wirklich haben. Daraus lesen wir ab,
-- wie das Schloss heisst.
function Mailbox.dumpPetRaw()
	local pets, err = Mailbox.pets()
	if not pets or #pets == 0 then
		Hub.log("rohdaten: " .. tostring(err or "keine Pets"))
		nativeNotify("Big Hub", "Keine Pets lesbar.", 7)
		return
	end

	-- welche Felder gibt es, und wie oft sind sie gesetzt?
	local fields, order = {}, {}
	for _, info in ipairs(pets) do
		for key, value in pairs(info.raw) do
			local entry = fields[key]
			if not entry then
				entry = { count = 0, truthy = 0, samples = {} }
				fields[key] = entry
				table.insert(order, key)
			end
			entry.count += 1
			if value ~= false and value ~= nil and value ~= 0 then
				entry.truthy += 1
			end
			if #entry.samples < 3 then
				table.insert(entry.samples, tostring(value) .. " (" .. typeof(value) .. ")")
			end
		end
	end
	-- ueber tostring sortieren: die Schluessel koennen Text und Zahlen mischen,
	-- und table.sort stuerzt beim Vergleich der beiden Typen ab
	table.sort(order, function(a, b)
		return tostring(a) < tostring(b)
	end)

	Hub.log("--- Pet-Felder ueber " .. #pets .. " Pets ---")
	for _, key in ipairs(order) do
		local entry = fields[key]
		Hub.log("  " .. tostring(key) .. "  in " .. entry.count .. " Pets, "
			.. entry.truthy .. " davon gesetzt   z.B. "
			.. table.concat(entry.samples, " | "))
	end

	-- Kandidaten fuer das Schloss: wenige Pets, Wert true
	Hub.log("Verdaechtig fuer das Schloss (wenige Pets, Wert gesetzt):")
	for _, key in ipairs(order) do
		local entry = fields[key]
		if entry.truthy > 0 and entry.truthy < #pets then
			local sample = entry.samples[1] or ""
			if sample:find("boolean") or sample:find("1 %(number%)") then
				Hub.log("  LockKey = \"" .. key .. "\",   -> " .. entry.truthy
					.. " von " .. #pets .. " Pets")
			end
		end
	end

	-- die ersten drei Pets vollstaendig
	Hub.log("Erste Pets vollstaendig:")
	for index = 1, math.min(#pets, 3) do
		local info = pets[index]
		Hub.log("  " .. info.name .. "  (locked laut Hub: " .. tostring(info.locked)
			.. ", Feld " .. tostring(info.lockField) .. ")")
		for key, value in pairs(info.raw) do
			Hub.log("      " .. tostring(key) .. " = " .. tostring(value))
		end
	end

	local locked = 0
	for _, info in ipairs(pets) do
		if info.locked then
			locked += 1
		end
	end
	Hub.log("Der Hub haelt " .. locked .. " von " .. #pets .. " Pets fuer gesperrt.")
	Hub.log("--- Ende Rohdaten ---")
	nativeNotify("Big Hub", locked .. " von " .. #pets .. " gelten als gesperrt.", 8)
end

