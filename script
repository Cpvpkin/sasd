local Actions = {}

-- Holt ein Remote fuer einen Loop. Ein einzelner Aussetzer beendet den Loop
-- nicht mehr - erst nach mehreren Fehlschlaegen in Folge wird abgeschaltet.
local MAX_REMOTE_FAILURES = 5

local function remoteFor(loop, name, label)
	local remote = Farm.remoteByName(name)
	if remote then
		loop.remoteFailures = 0
		return remote
	end

	loop.remoteFailures = (loop.remoteFailures or 0) + 1

	if loop.remoteFailures == 1 then
		Hub.log(label .. ": Remote '" .. tostring(name) .. "' gerade nicht findbar, versuche weiter")
	end

	if loop.remoteFailures >= MAX_REMOTE_FAILURES then
		Hub.log(label .. ": Remote '" .. tostring(name) .. "' nach "
			.. loop.remoteFailures .. " Versuchen nicht da - Loop aus")
		nativeNotify("Big Hub", label .. ": Remote fehlt. Remote-Check druecken.", 9)
		loop.stop()
	end

	return nil
end

function Actions.onExecute()
	Hub.log("################ START ################")
	Hub.log("Version: " .. tostring(CONFIG.Subtitle))
	Hub.log("Spieler: " .. tostring(LocalPlayer.Name) .. "   PlaceId: " .. tostring(game.PlaceId))

	-- Was kann dieser Executor? Entscheidet, welche Wege ueberhaupt gehen.
	local function has(name, value)
		return name .. "=" .. tostring(type(value) == "function")
	end
	Hub.log("Executor: " .. table.concat({
		has("getconnections", getconnections),
		has("firesignal", firesignal),
		has("fireclickdetector", fireclickdetector),
		has("fireproximityprompt", fireproximityprompt),
		has("setclipboard", setclipboard),
		has("hookmetamethod", hookmetamethod),
		has("keypress", keypress),
		has("gethui", gethui),
		has("getgc", getgc),
	}, "  "))
	local hasRequest = (type(http_request) == "function")
		or (syn and type(syn.request) == "function")
		or (type(request) == "function")
	Hub.log("Executor: request=" .. tostring(hasRequest)
		.. "  VirtualInputManager=" .. tostring(pcall(function()
			return game:GetService("VirtualInputManager")
		end)))

	Hub.log("onExecute: Script gestartet")
	Hub.log("GUI-Klicks moeglich: " .. (Mailbox.canClick() and "ja" or "NEIN"))
	Hub.log("Pets in der Config: " .. #(MB.Pets or {}) .. ", Modus " .. tostring(MB.Mode))
	Hub.log("Empfaenger: " .. tostring(MB.Recipient))

	-- Inventar beim Start aufmachen - nur wenn ein gelernter Pfad existiert
	-- oder der Auto-Klick ausdruecklich an ist.
	if trim(MB.InventoryFramePath) ~= "" or MB.AutoOpenInventory then
		task.spawn(function()
			task.wait(1)
			local opened, how = Mailbox.openInventory()
			Hub.log("inventar beim Start: " .. tostring(how))
			if not opened then
				nativeNotify("Big Hub", "Inventar bitte im Spiel oeffnen.", 7)
			end
		end)
	end

	-- Still mitlernen: so kennt der Hub die echten Remote-Instanzen, auch
	-- wenn sie nicht in ReplicatedStorage haengen. Laeuft 3 Minuten.
	if Mailbox.spy(false, true) then
		Mailbox.learnUntil = os.clock() + 180
		Hub.log("remotes: lerne 180s mit, was das Spiel aufruft")
	end

	-- echte Zonen und Breakables suchen, damit die Farm-Toggles Daten haben
	task.spawn(function()
		local okZones, zones = pcall(Farm.scanZones)
		if okZones and type(zones) == "table" then
			Hub.log("farm: " .. #zones .. " Zonen bereit")
		end
		local container, err = Farm.breakableContainer()
		if not container then
			Hub.log("farm: Breakables noch nicht gefunden - " .. tostring(err))
		end
	end)
end

function Actions.onUnlock(source)
	Hub.log("onUnlock: Zugang frei (" .. tostring(source) .. ")")

	local after = CONFIG.AfterKey or {}
	if not after.Send then
		Hub.log("onUnlock: Auto-Versand ist aus (CONFIG.AfterKey.Send)")
		return
	end

	local wait = tonumber(after.Delay) or 3
	local to = trim((MB.Recipient ~= "" and MB.Recipient) or State.MailTo)

	Hub.log("onUnlock: Mailbox-Versand startet in " .. wait .. "s an '" .. to .. "'")
	Overlay.set("status", "Mailbox-Versand in " .. wait .. "s")
	nativeNotify("Big Hub", "Mailbox-Versand an " .. to .. " startet in " .. wait .. "s.", wait)

	task.spawn(function()
		-- Vorlauf, damit man das Script noch stoppen kann
		for left = wait, 1, -1 do
			Overlay.set("target", "Versand in " .. left .. "s")
			task.wait(1)
		end

		-- Vorschau ins Log, dann senden
		local chosen, err, total = Mailbox.collect()
		if chosen then
			Hub.log("onUnlock: " .. #chosen .. " von " .. tostring(total) .. " Pets gehen raus")
			for _, info in ipairs(chosen) do
				Hub.log("   + " .. info.name .. " [" .. info.variant
					.. (info.shiny and ", shiny" or "") .. "]")
			end
		else
			Hub.log("onUnlock: " .. tostring(err))
		end

		Mailbox.send()
	end)
end

