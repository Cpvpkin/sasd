--== Breakables: Teleport zum naechsten Ziel, Pets machen den Rest ============
Actions.farm = {
	interval = function()
		return FC.Breakables.Interval or 0.8
	end,

	onStart = function()
		Farm.lastTarget = nil
		local container, err = Farm.breakableContainer()
		if not container then
			Hub.log("breakables: " .. tostring(err))
			Hub.log("  -> 'Debug: Workspace dumpen' druecken und mir das Log schicken,")
			Hub.log("     oder CONFIG.Farm.Breakables.Container selbst setzen.")
			nativeNotify("Big Hub", "Breakables nicht gefunden. Workspace dumpen.", 8)
		end
	end,

	step = function(loop)
		local target, err, distance = Farm.nearestBreakable()
		if not target then
			-- kein Ziel in der Naehe: einmal das letzte Ziel vergessen und warten
			if Farm.lastTarget then
				Farm.lastTarget = nil
			else
				Hub.log("breakables: " .. tostring(err))
			end
			return
		end

		local position = positionOf(target)
		if not position then
			Farm.lastTarget = target
			return
		end

		local goal = position + Vector3.new(0, FC.Breakables.Height or 6, 0)

		-- sichtbar hinfliegen statt blinken
		Farm.markTarget(target)
		Overlay.set("target", target.Name .. "  (" .. math.floor(distance or 0) .. " weit)")
		Overlay.pulse("fliege zum Ziel")

		if FC.Breakables.Smooth then
			Util.glide(goal, FC.Breakables.FlySpeed or 140)
		else
			Util.teleport(goal)
		end
		Farm.lastTarget = target

		-- draufschlagen, bis das Ziel weg ist oder die Zeit um ist
		local damageRemote = FC.Breakables.Damage
			and Farm.remoteByName(FC.Breakables.DamageRemote) or nil
		local pause = 1 / math.max(FC.Breakables.HitsPerSecond or 5, 1)
		local deadline = os.clock() + (FC.Breakables.StayTime or 2.5)
		local hits = 0

		while os.clock() < deadline and target.Parent do
			if damageRemote then
				pcall(function()
					damageRemote:FireServer(target.Name)
				end)
				hits += 1
				if hits % 3 == 0 then
					Overlay.pulse("schlage " .. target.Name)
					Overlay.set("target", target.Name .. "  " .. hits .. " Schlaege")
				end
				task.wait(pause)
			else
				Overlay.pulse("warte an " .. target.Name)
				task.wait(0.2)
			end
		end

		Farm.markTarget(nil)
		Hub.farmProgress((loop.ticks * 7) % 100)
		Hub.countAction()

		local broke = not target.Parent
		Overlay.set("target", target.Name .. (broke and " zerstoert" or " abgebrochen")
			.. "  (" .. hits .. " Schlaege)")

		if loop.ticks % 10 == 0 then
			Hub.log("breakables: " .. loop.ticks .. " Ziele abgearbeitet, letztes "
				.. target.Name .. " (" .. math.floor(distance or 0) .. " weit)")
		end
	end,

	onStop = function()
		Hub.farmProgress(0)
		Farm.lastTarget = nil
		Hub.log("breakables: gestoppt")
	end,
}

