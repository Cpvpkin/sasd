				.. (info.locked and "  GESPERRT" or "")
				.. (info.equipped and "  ANGELEGT" or "")
				.. "  uid=" .. tostring(info.uid))
		end
		if #chosen == 0 then
			local shown = 0
			for name, why in pairs(Mailbox.lastReasons) do
				Hub.log("  - " .. name .. ": " .. tostring(why))
				shown += 1
				if shown >= 12 then
					break
				end
			end
		end
		Hub.status(#chosen .. " von " .. tostring(total) .. " Pets passen")
		nativeNotify("Big Hub", #chosen .. " von " .. tostring(total) .. " Pets passen zur Config.", 6)
	end,
})

