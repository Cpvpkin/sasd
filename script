local function networkRemote(name)
	local network = ReplicatedStorage:FindFirstChild("Network")
	if not network then
		return nil, "ReplicatedStorage.Network fehlt"
	end
	local remote = network:FindFirstChild(name)
	if not remote then
		return nil, "Remote '" .. tostring(name) .. "' fehlt"
	end
	return remote
end

Mailbox.networkRemote = networkRemote

-- Beliebigen Wert lesbar in die Konsole schreiben
local function dumpValue(value, indent, depth)
	indent = indent or "  "
	depth = depth or 0

	if typeof(value) ~= "table" then
		Hub.log(indent .. tostring(value) .. "  (" .. typeof(value) .. ")")
		return
	end
	if depth >= 4 then
		Hub.log(indent .. "{ ... noch tiefer }")
		return
	end

	local count = 0
	for key, item in pairs(value) do
		count += 1
		if count > 30 then
			Hub.log(indent .. "... weitere Eintraege")
			break
		end
		if typeof(item) == "table" then
			Hub.log(indent .. "[" .. tostring(key) .. "] = table")
			dumpValue(item, indent .. "  ", depth + 1)
		else
			Hub.log(indent .. "[" .. tostring(key) .. "] = " .. tostring(item)
				.. "  (" .. typeof(item) .. ")")
		end
	end
	if count == 0 then
		Hub.log(indent .. "(leere Tabelle)")
	end
end

-- Nur lesen: zeigt, was der Server ueber deine Mailbox zurueckgibt
function Mailbox.dumpRequest()
	local remote, err = networkRemote(MB.RequestRemote)
	if not remote then
		Hub.log("request: " .. tostring(err))
		nativeNotify("Big Hub", tostring(err), 7)
		return
	end

	Hub.log("--- " .. remote.Name .. ":InvokeServer() ---")
	local ok, result = pcall(function()
		return remote:InvokeServer()
	end)
	if not ok then
		Hub.log("fehler: " .. tostring(result))
	else
		dumpValue(result, "  ", 0)
	end
	Hub.log("--- Ende ---")
	nativeNotify("Big Hub", "Mailbox-Daten in der Konsole.", 5)
end

-- Dein MailLog aus den Spieldaten: zeigt, wie das Spiel verschickte Items
-- speichert. Daraus lesen wir das Item-Format fuer das Send-Remote.
function Mailbox.dumpMailLog()
	local data, err = Mailbox.save()
	if not data then
		Hub.log("maillog: " .. tostring(err))
		nativeNotify("Big Hub", tostring(err), 8)
		return
	end

	local log = data.MailLog or data.Mail or data.Mailbox
	if type(log) ~= "table" then
		Hub.log("maillog: kein MailLog in den Spieldaten")
		nativeNotify("Big Hub", "Kein MailLog gefunden.", 6)
		return
	end

	Hub.log("--- MailLog ---")
	dumpValue(log, "  ", 0)

	-- Tageslimit pruefen: wie viele Sendungen in den letzten 24 Stunden?
	local now = os.time()
	local sentTotal, sentToday, newest = 0, 0, 0
	for _, entry in pairs(log) do
		if type(entry) == "table" and tostring(entry.Type) == "Sent" then
			sentTotal += 1
			local stamp = tonumber(entry.Timestamp) or 0
			if stamp > newest then
				newest = stamp
			end
			if now - stamp < 86400 then
				sentToday += 1
			end
		end
	end

	Hub.log("Sendungen im Log: " .. sentTotal .. ", davon letzte 24h: " .. sentToday)
	if newest > 0 then
		Hub.log("letzte Sendung vor " .. math.floor((now - newest) / 60) .. " Minuten")
	end

	local reset = tonumber(data.MailboxResetTime)
	if reset then
		local diff = reset - now
		if diff > 0 then
			Hub.log("MailboxResetTime: in " .. math.floor(diff / 60) .. " Minuten")
		else
			Hub.log("MailboxResetTime: vor " .. math.floor(-diff / 60) .. " Minuten (abgelaufen)")
		end
	end
	if data.IsTradeBanned ~= nil then
		Hub.log("IsTradeBanned: " .. tostring(data.IsTradeBanned))
	end

	Hub.log("--- Ende MailLog ---")
	nativeNotify("Big Hub", sentToday .. " Sendungen in 24h, siehe Konsole.", 6)
end

