-- Schickt das zuletzt erhaltene Pet durch die komplette Meldekette.
-- Damit laesst sich das Melden pruefen, ohne auf einen Hatch zu warten.
function Web.testPet()
	local pets, err = Mailbox.pets()
	if not pets or #pets == 0 then
		Hub.log("webhook: kein Pet im Inventar lesbar - " .. tostring(err))
		nativeNotify("Big Hub", "Keine Pets lesbar: " .. tostring(err), 8)
		return
	end

	-- irgendeins nehmen, bevorzugt ein seltenes, damit der Filter sichtbar wird
	local pick = pets[#pets]
	for _, info in ipairs(pets) do
		if Web.isRare(info) then
			pick = info
			break
		end
	end

	Hub.log("webhook: Testmeldung fuer '" .. pick.name .. "' (rare="
		.. tostring(Web.isRare(pick)) .. ", Modus " .. tostring(WH.Mode) .. ")")
	local ok = Web.sendPet(pick, "Testmeldung")
	nativeNotify("Big Hub", ok and ("Pet-Meldung gesendet: " .. pick.name)
		or "Pet-Meldung fehlgeschlagen, siehe Konsole", 8)
end

