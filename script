-- Alles hier laeuft in pcall. Eine Anzeige darf nie den Aufrufer abbrechen.
function Overlay.set(key, text)
	if not Overlay.enabled or Overlay.broken then
		return
	end
	pcall(function()
		if not Overlay.build() then
			return
		end
		local label = Overlay.rows[key]
		if not label then
			return
		end
		for _, row in ipairs(ROW_ORDER) do
			if row.key == key then
				label.Text = row.label .. ": " .. tostring(text)
				return
			end
		end
	end)
end

-- Dreht das Zeichen im Titel weiter. Bewegt sich = der Hub arbeitet.
function Overlay.pulse(what)
	if not Overlay.enabled or Overlay.broken then
		return
	end
	pcall(function()
		if not Overlay.build() then
			return
		end
		Overlay.spinnerIndex = (Overlay.spinnerIndex % #SPINNER) + 1
		Overlay.title.Text = CONFIG.Name .. "  " .. SPINNER[Overlay.spinnerIndex]
			.. "  " .. tostring(what or "laeuft")
	end)
end

function Overlay.setVisible(value)
	Overlay.enabled = value
	if Overlay.gui then
		pcall(function()
			Overlay.gui.Enabled = value
		end)
	end
	if value then
		Overlay.build()
	end
end

